+
+// ---------------------------------------------------------------------------
+// Prévia real do traço de cada pincel, a mesma do editor de pincéis do Krita.
+// Um renderizador escondido faz um pincel por vez (o motor é assíncrono) e
+// guarda o resultado na memória e em disco. Enquanto o traço não fica pronto a
+// linha mostra a amostra desenhada; pincéis que o motor não consegue prever
+// usam a miniatura que vem dentro do próprio preset.
+// ---------------------------------------------------------------------------
+class BrushPreviewer : public QObject
+{
+public:
+    enum State { Ready, Pending, Unsupported };
+    static const int RENDER_W = 400;
+    static const int RENDER_H = 96;
+
+    static BrushPreviewer *instance(KisMainWindow *mw = nullptr)
+    {
+        static QPointer<BrushPreviewer> s_instance;
+        if (!s_instance && mw) s_instance = new BrushPreviewer(mw);
+        return s_instance;
+    }
+
+    // listas que precisam ser repintadas quando um traço fica pronto
+    void watch(QWidget *w) { m_watchers << QPointer<QWidget>(w); }
+
+    State request(const KisPaintOpPresetSP &preset, QImage *out)
+    {
+        if (!preset || !preset->settings()) return Unsupported;
+        const int id = preset->resourceId();
+        const auto it = m_images.constFind(id);
+        if (it != m_images.constEnd()) {
+            if (it.value().isNull()) return Unsupported;
+            *out = it.value();
+            return Ready;
+        }
+        if (m_queued.contains(id)) return Pending;
+        const QString engine = preset->paintOp().id();
+        if (engine == QLatin1String("roundmarker") || engine == QLatin1String("experimentbrush")
+                || engine == QLatin1String("duplicate")) {
+            m_images.insert(id, QImage());
+            return Unsupported;
+        }
+        const QString file = cacheFile(preset);
+        QImage cached;
+        if (!file.isEmpty() && cached.load(file)) {
+            m_images.insert(id, cached);
+            *out = cached;
+            return Ready;
+        }
+        m_queued.insert(id);
+        m_queue.prepend(id);   // o que acabou de aparecer na tela vai primeiro
+        QTimer::singleShot(0, this, [this]() { pump(); });
+        return Pending;
+    }
+
+private:
+    explicit BrushPreviewer(KisMainWindow *mw)
+        : QObject(mw)
+        , m_mw(mw)
+    {
+        m_timeout.setSingleShot(true);
+        m_timeout.setInterval(4000);
+        QObject::connect(&m_timeout, &QTimer::timeout, this, [this]() {
+            if (m_busy) finish(m_current, QImage());   // não veio: fica com a amostra desenhada
+        });
+    }
+
+    static QString cacheDir()
+    {
+        return QStandardPaths::writableLocation(QStandardPaths::CacheLocation) + QStringLiteral("/brushpreview");
+    }
+
+    static QString cacheFile(const KisPaintOpPresetSP &preset)
+    {
+        const QString md5 = preset->md5Sum();
+        if (md5.isEmpty()) return QString();
+        return cacheDir() + QStringLiteral("/v1-") + md5 + QStringLiteral(".png");
+    }
+
+    bool ensureView()
+    {
+        if (m_view) return true;
+        if (!m_mw) return false;
+        KoCanvasResourceProvider *r = resources(m_mw);
+        if (!r) return false;
+        m_view = new KisPresetLivePreviewView(m_mw);
+        m_view->setFixedSize(RENDER_W, RENDER_H);
+        m_view->hide();
+        // papel claro e tinta escura: o traço aparece como ficaria na página
+        QPalette pal = m_view->palette();
+        pal.setColor(QPalette::Window, QColor(0xfa, 0xfa, 0xf7));
+        pal.setColor(QPalette::Text, QColor(0x1b, 0x1d, 0x22));
+        m_view->setPalette(pal);
+        m_view->setup(r);
+        QObject::connect(m_view, &KisPresetLivePreviewView::previewReady, this, [this]() { onReady(); });
+        return true;
+    }
+
+    void pump()
+    {
+        if (m_busy || m_queue.isEmpty()) return;
+        if (!ensureView()) {
+            QTimer::singleShot(500, this, [this]() { pump(); });
+            return;
+        }
+        const int id = m_queue.takeFirst();
+        KisPaintOpPresetSP preset = presetForId(id);
+        if (!preset || !preset->settings()) {
+            finish(id, QImage());
+            return;
+        }
+        m_busy = true;
+        m_current = id;
+        m_timeout.start();
+        m_view->setCurrentPreset(preset);
+        m_view->requestUpdateStroke();
+    }
+
+    void onReady()
+    {
+        if (!m_busy) return;
+        const QImage img = m_view->previewImage();
+        finish(m_current, img.isNull() ? QImage() : img.convertToFormat(QImage::Format_RGB32));
+    }
+
+    void finish(int id, const QImage &img)
+    {
+        m_timeout.stop();
+        m_busy = false;
+        m_queued.remove(id);
+        m_images.insert(id, img);
+        if (!img.isNull()) {
+            KisPaintOpPresetSP preset = presetForId(id);
+            const QString file = preset ? cacheFile(preset) : QString();
+            if (!file.isEmpty()) {
+                QDir().mkpath(cacheDir());
+                img.save(file, "PNG");
+            }
+        }
+        for (const QPointer<QWidget> &w : m_watchers) {
+            if (w) w->update();
+        }
+        QTimer::singleShot(0, this, [this]() { pump(); });
+    }
+
+    QPointer<KisMainWindow> m_mw;
+    QPointer<KisPresetLivePreviewView> m_view;
+    QHash<int, QImage> m_images;      // imagem nula = sem prévia para esse motor
+    QSet<int> m_queued;
+    QList<int> m_queue;
+    QList<QPointer<QWidget>> m_watchers;
+    QTimer m_timeout;
+    bool m_busy = false;
+    int m_current = -1;
+};
