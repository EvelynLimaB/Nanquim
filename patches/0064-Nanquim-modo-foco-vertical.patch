From 053e7ae07a1a21ca724411cce54e112e34c06f6a Mon Sep 17 00:00:00 2001
From: Nanquim <nanquim@users.noreply.github.com>
Date: Tue, 17 Nov 2026 11:31:30 -0300
Subject: [PATCH] Nanquim: modo foco no formato do gesto de quatro dedos

- Dock do polegar, bolinha de cor e as 3 cores rapidas continuam no modo foco
- Capsula de ferramentas na vertical, logo acima das 3 cores
- Coluna de tamanho abre para o lado de dentro, deslizando

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fwRUW9SkxqcJFLYxLRXTf
---
 libs/ui/NanquimTabletUi.cpp | 60 +++++++++++++++++++++++++------------
 1 file changed, 41 insertions(+), 19 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index 8c707c5..2ce12b0 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -176,7 +176,7 @@ const char *WELCOME_ONLY = "nanquimWelcomeOnly";
 
 bool s_canvasCleaned = false;
 bool s_navCollapsed = false;
-bool s_focusMode = false;   // modo foco: só a página e a cápsula de 3 ferramentas
+bool s_focusMode = false;   // modo foco: só a página, o dock do polegar, as 3 cores e a cápsula vertical de ferramentas
 bool s_classic = false;   // modo de interface desta sessão (decidido ao abrir o app)
 
 bool isClassicMode()
@@ -936,7 +936,7 @@ protected:
         QToolButton *sizeBtn = m_mw->findChild<QToolButton*>(QStringLiteral("nanquimFocusSizeButton"));
         if (host && host->isVisible()) open = host;
         else if (brushes && brushes->isVisible()) open = brushes;
-        else if (sizeBox && sizeBtn && sizeBox->isVisible() && sizeBox->height() > 0) open = sizeBox;
+        else if (sizeBox && sizeBtn && sizeBox->isVisible() && sizeBox->property("nanquimOpen").toBool()) open = sizeBox;
         if (!open) return false;
 
         QPoint global;
@@ -4157,21 +4157,37 @@ void placeFocusWidgets(KisMainWindow *mw)
     QWidget *central = mw->centralWidget();
     if (!central) return;
     const QRect area(central->mapTo(mw, QPoint(0, 0)), central->size());
+    const bool right = railOnRight();
     if (QFrame *bar = mw->findChild<QFrame*>(QStringLiteral("nanquimFocusBar"))) {
         bar->adjustSize();
-        const int x = railOnRight() ? area.right() - 20 - bar->width() + 1 : area.left() + 20;
-        bar->move(x, area.bottom() - 20 - bar->height() + 1);
+        // cápsula vertical logo acima das 3 cores, no mesmo eixo do dock do polegar
+        QFrame *quick = mw->findChild<QFrame*>(QUICK_COLORS_ID);
+        QFrame *dock = mw->findChild<QFrame*>(THUMB_DOCK_ID);
+        QWidget *ref = (quick && quick->isVisible()) ? static_cast<QWidget*>(quick)
+                       : (dock && dock->isVisible()) ? static_cast<QWidget*>(dock) : nullptr;
+        int x = right ? area.right() - 12 - bar->width() + 1 : area.left() + 12;
+        int y = area.bottom() - 20 - bar->height() + 1;
+        if (ref) {
+            x = ref->x() + (ref->width() - bar->width()) / 2;
+            y = ref->y() - 12 - bar->height();
+        }
+        bar->move(x, qMax(area.top() + 56, y));
         bar->raise();
         QFrame *sizeBox = mw->findChild<QFrame*>(QStringLiteral("nanquimFocusSize"));
         QToolButton *sizeBtn = bar->findChild<QToolButton*>(QStringLiteral("nanquimFocusSizeButton"));
         if (sizeBox && sizeBtn && sizeBox->isVisible()) {
-            const QPoint c = sizeBtn->mapTo(mw, sizeBtn->rect().center());
-            sizeBox->move(c.x() - sizeBox->width() / 2, bar->y() - 10 - sizeBox->height());
+            // abre para o lado de dentro, deslizando
+            const qreal slide = qBound(0.0, sizeBox->property("nanquimSlide").toReal(), 1.2);
+            const int offset = qRound((1.0 - slide) * 28);
+            const int cy = sizeBtn->mapTo(mw, sizeBtn->rect().center()).y();
+            const int by = qBound(area.top() + 8, cy - sizeBox->height() / 2, area.bottom() - 8 - sizeBox->height());
+            const int bx = right ? bar->x() - 10 - sizeBox->width() + offset : bar->x() + bar->width() + 10 - offset;
+            sizeBox->move(bx, by);
             sizeBox->raise();
         }
     }
     if (QToolButton *exit = mw->findChild<QToolButton*>(QStringLiteral("nanquimFocusExit"))) {
-        const int x = railOnRight() ? area.left() + 20 : area.right() - 20 - exit->width() + 1;
+        const int x = right ? area.left() + 20 : area.right() - 20 - exit->width() + 1;
         exit->move(x, area.top() + 20);
         exit->raise();
     }
@@ -4179,11 +4195,11 @@ void placeFocusWidgets(KisMainWindow *mw)
 
 void placeThumbDock(KisMainWindow *mw)
 {
-    placeFocusWidgets(mw);
     QFrame *dock = mw->findChild<QFrame*>(THUMB_DOCK_ID);
     QToolButton *swatch = mw->findChild<QToolButton*>(SWATCH_ID);
     QWidget *central = mw->centralWidget();
     if (!dock || !swatch || !central) {
+        placeFocusWidgets(mw);
         return;
     }
     const QRect area(central->mapTo(mw, QPoint(0, 0)), central->size());
@@ -4202,6 +4218,7 @@ void placeThumbDock(KisMainWindow *mw)
         quick->move(x + (dock->width() - quick->width()) / 2, qMax(area.top() + margin, qy));
         quick->raise();
     }
+    placeFocusWidgets(mw);
 }
 
 void setThumbDockVisible(KisMainWindow *mw, bool visible)
@@ -4366,14 +4383,15 @@ void buildFocusWidgets(KisMainWindow *mw)
     QFrame *bar = new QFrame(mw);
     bar->setObjectName(QStringLiteral("nanquimFocusBar"));
     bar->setStyleSheet(QStringLiteral(
-        "QFrame#nanquimFocusBar { background: rgba(34,38,44,0.92); border: 1px solid #33373f; border-radius: 30px; }"
+        "QFrame#nanquimFocusBar { background: rgba(34,38,44,0.92); border: 1px solid #33373f; border-radius: 28px; }"
         "QFrame#nanquimFocusBar QToolButton { border: none; border-radius: 12px; padding: 0;"
         "  min-width: 48px; max-width: 48px; min-height: 48px; max-height: 48px; }"
         "QFrame#nanquimFocusBar QToolButton:pressed { background: #2a2e35; }"
         "QFrame#nanquimFocusBar QToolButton:checked { background: #16294a; }"
         "QFrame#nanquimFocusBar QToolButton[nanquimHover=\"true\"]:!checked { background: rgba(255,255,255,0.08); }"));
-    QHBoxLayout *l = new QHBoxLayout(bar);
-    l->setContentsMargins(8, 4, 8, 4);
+    // build 60.5: cápsula na vertical, junto das 3 cores (mesmo desenho do gesto de quatro dedos)
+    QVBoxLayout *l = new QVBoxLayout(bar);
+    l->setContentsMargins(4, 8, 4, 8);
     l->setSpacing(2);
     QAction *erase = act(mw, "erase_action");
     struct Entry { const char *tip; const char *svg; const char *id; bool eraser; };
@@ -4428,7 +4446,9 @@ void buildFocusWidgets(KisMainWindow *mw)
     sizeSlider->setFocusPolicy(Qt::NoFocus);
     sbl->addWidget(sizeLabel);
     sbl->addWidget(sizeSlider, 1, Qt::AlignHCenter);
-    sizeBox->setFixedHeight(0);
+    sizeBox->setFixedHeight(236);
+    sizeBox->setProperty("nanquimSlide", 0.0);
+    sizeBox->setProperty("nanquimOpen", false);
     sizeBox->hide();
 
     QObject::connect(sizeSlider, &QSlider::valueChanged, mw, [mw, sizeLabel](int v) {
@@ -4455,25 +4475,26 @@ void buildFocusWidgets(KisMainWindow *mw)
     auto openSize = [mwGuard, sizeBox, sizeBtn, pullSize](bool open) {
         if (!mwGuard) return;
         sizeBtn->setChecked(open);
+        sizeBox->setProperty("nanquimOpen", open);
         QVariantAnimation *old = sizeBox->findChild<QVariantAnimation*>(QStringLiteral("nanquimSizeAnim"));
         if (old) old->stop();
         if (open) { pullSize(); sizeBox->show(); sizeBox->raise(); }
         QVariantAnimation *a = old ? old : new QVariantAnimation(sizeBox);
         a->setObjectName(QStringLiteral("nanquimSizeAnim"));
         a->disconnect();
-        a->setStartValue(sizeBox->height());
-        a->setEndValue(open ? 236 : 0);
-        a->setDuration(open ? 280 : 170);
+        a->setStartValue(sizeBox->property("nanquimSlide").toReal());
+        a->setEndValue(open ? 1.0 : 0.0);
+        a->setDuration(open ? 260 : 160);
         a->setEasingCurve(open ? softSpring() : QEasingCurve(QEasingCurve::InCubic));
         QObject::connect(a, &QVariantAnimation::valueChanged, sizeBox, [mwGuard, sizeBox](const QVariant &v) {
-            sizeBox->setFixedHeight(qMax(0, v.toInt()));
+            sizeBox->setProperty("nanquimSlide", v.toReal());
             if (mwGuard) placeFocusWidgets(mwGuard);
         });
         QObject::connect(a, &QVariantAnimation::finished, sizeBox, [sizeBox, open]() { if (!open) sizeBox->hide(); });
         a->start();
     };
     QObject::connect(sizeBtn, &QToolButton::clicked, mw, [openSize, sizeBox](bool) {
-        openSize(!(sizeBox->isVisible() && sizeBox->height() > 0));
+        openSize(!sizeBox->property("nanquimOpen").toBool());
     });
 
     KoToolManager *toolManager = mw->viewManager()->toolManager();
@@ -4513,13 +4534,14 @@ void applyFocusVisibility(KisMainWindow *mw)
     if (QToolBar *top = mw->findChild<QToolBar*>(TOP_ID)) top->setVisible(!on);
     if (QToolBar *nav = mw->findChild<QToolBar*>(NAV_ID)) nav->setVisible(!on && !s_navCollapsed);
     if (QWidget *tab = mw->findChild<QWidget*>(QStringLiteral("nanquimExpandTab"))) tab->setVisible(!on && s_navCollapsed);
-    setThumbDockVisible(mw, !on);
+    setThumbDockVisible(mw, true);   // dock do polegar e 3 cores ficam, como no gesto de quatro dedos
     flushLayouts();
     if (QWidget *bar = mw->findChild<QWidget*>(QStringLiteral("nanquimFocusBar"))) bar->setVisible(on);
     if (QWidget *exit = mw->findChild<QWidget*>(QStringLiteral("nanquimFocusExit"))) exit->setVisible(on);
     if (!on) {
         if (QFrame *sizeBox = mw->findChild<QFrame*>(QStringLiteral("nanquimFocusSize"))) {
-            sizeBox->setFixedHeight(0);
+            sizeBox->setProperty("nanquimOpen", false);
+            sizeBox->setProperty("nanquimSlide", 0.0);
             sizeBox->hide();
         }
         if (QToolButton *b = mw->findChild<QToolButton*>(QStringLiteral("nanquimFocusSizeButton"))) b->setChecked(false);
