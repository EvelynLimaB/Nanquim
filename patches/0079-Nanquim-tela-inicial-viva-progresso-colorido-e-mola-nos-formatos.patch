+        g.setPen(Qt::NoPen);
+        g.setBrush(QColor(0x3d, 0x8b, 0xff, isDown() ? 55 : 28));
+        g.drawRoundedRect(badge, 9, 9);
+        g.drawPixmap(int(badge.left()) + 7, int(badge.top()) + 7, m_icon);
+
         QFont f = font();
         f.setPixelSize(15);
         f.setWeight(QFont::DemiBold);
         g.setFont(f);
         g.setPen(C_TEXT);
-        const int x = 52;
+        const int x = 56;
         g.drawText(QRect(x, 8, width() - x - 10, 20), Qt::AlignLeft | Qt::AlignVCenter,
                    QFontMetrics(f).elidedText(m_title, Qt::ElideRight, width() - x - 10));
         QFont s = font();
