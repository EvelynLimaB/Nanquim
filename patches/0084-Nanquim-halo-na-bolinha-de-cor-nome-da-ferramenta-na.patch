Date: Wed, 18 Nov 2026 10:37:03 -0300
Subject: [PATCH 84/85] =?UTF-8?q?Nanquim:=20halo=20na=20bolinha=20de=20cor?=
 =?UTF-8?q?,=20nome=20da=20ferramenta=20na=20tela=20cheia=20e=20caixas=20d?=
 =?UTF-8?q?e=20sele=C3=A7=C3=A3o=20em=20degrad=C3=AA?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- A bolinha de cor ganha um halo da própria cor
- Na tela cheia, trocar de ferramenta mostra o nome num aviso rápido
- Caixas de seleção ligadas ficam em degradê ciano e azul, como as chaves do protótipo
---
 libs/ui/NanquimTabletUi.cpp | 43 +++++++++++++++++++++++++++++++++----
 1 file changed, 39 insertions(+), 4 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index 34da3cb..2e3fb48 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -4408,13 +4408,28 @@ QIcon swatchIcon(const QColor &c, int size)
     pm.fill(Qt::transparent);
     QPainter g(&pm);
     g.setRenderHint(QPainter::Antialiasing);
+    // halo da própria cor em volta da bolinha
+    {
+        const QPointF mid(size / 2.0, size / 2.0);
+        QRadialGradient halo(mid, size / 2.0);
+        QColor strong(c);
+        strong.setAlpha(150);
+        QColor none(c);
+        none.setAlpha(0);
+        halo.setColorAt(0.0, strong);
+        halo.setColorAt(0.78, strong);
+        halo.setColorAt(1.0, none);
+        g.setPen(Qt::NoPen);
+        g.setBrush(halo);
+        g.drawEllipse(QRectF(0, 0, size, size));
+    }
     // anel escuro + anel claro: a cor aparece sobre papel branco e sobre a interface
     g.setPen(QPen(QColor(0x0e, 0x0f, 0x12), 3));
     g.setBrush(Qt::NoBrush);
-    g.drawEllipse(QRectF(2.5, 2.5, size - 5, size - 5));
+    g.drawEllipse(QRectF(4.5, 4.5, size - 9, size - 9));
     g.setPen(QPen(QColor(0xec, 0xee, 0xf2), 2));
     g.setBrush(c);
-    g.drawEllipse(QRectF(4, 4, size - 8, size - 8));
+    g.drawEllipse(QRectF(6, 6, size - 12, size - 12));
     g.end();
     return QIcon(pm);
 }
@@ -5268,7 +5283,26 @@ void buildFocusWidgets(KisMainWindow *mw)
             pair.first->setChecked(active == id && (!isBrush || pair.second.eraser == erasing));
         }
     };
-    QObject::connect(toolManager, &KoToolManager::changedTool, bar, [sync](KoCanvasController *) { sync(); });
+    // na tela cheia, o nome da ferramenta aparece num aviso rápido ao trocar
+    QObject::connect(toolManager, &KoToolManager::changedTool, bar, [sync, mwGuard, toolManager, erase](KoCanvasController *) {
+        sync();
+        static QString last;
+        if (!mwGuard || !canvasOnlyActive(mwGuard)) {
+            last.clear();
+            return;
+        }
+        const QString id = toolManager->activeToolId();
+        const bool erasing = erase && erase->isChecked();
+        QString name;
+        if (id == QLatin1String("KritaShape/KisToolBrush")) name = erasing ? i18n("Borracha") : i18n("Pincel");
+        else if (id == QLatin1String("KritaFill/KisToolFill")) name = i18n("Lata de tinta");
+        else if (id == QLatin1String("KisToolTransform")) name = i18n("Transformar");
+        if (name.isEmpty()) return;
+        const QString key = id + (erasing ? QStringLiteral("-e") : QString());
+        if (key == last) return;
+        last = key;
+        showToast(mwGuard, name);
+    });
     if (erase) QObject::connect(erase, &QAction::toggled, bar, [sync](bool) { sync(); });
     QTimer::singleShot(0, bar, sync);
     bar->adjustSize();
@@ -7923,7 +7957,8 @@ const char *SHEET_STYLE =
     "QComboBox QAbstractItemView { background: #15171b; color: #eceef2; border: 1px solid #2a2e35; selection-background-color: #16294a; }"
     "QCheckBox { color: #eceef2; font-size: 14px; spacing: 12px; min-height: 36px; }"
     "QCheckBox::indicator { width: 22px; height: 22px; border-radius: 6px; border: 2px solid #6b717c; background: #15171b; }"
-    "QCheckBox::indicator:checked { background: #3d8bff; border-color: #3d8bff; }"
+    "QCheckBox::indicator:checked { border-color: #6aa6ff;"
+    "  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #22d3ee, stop:1 #3d8bff); }"
     "QSlider { min-height: 30px; }"
     "QSlider::groove:horizontal { height: 6px; border-radius: 3px; background: #6b717c; }"
     "QSlider::sub-page:horizontal { border-radius: 3px;"
