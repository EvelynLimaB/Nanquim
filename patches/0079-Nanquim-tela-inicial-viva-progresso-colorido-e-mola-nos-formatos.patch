+        QLinearGradient bg(r.topLeft(), r.bottomLeft());
+        if (isDown()) {
+            bg.setColorAt(0.0, QColor(0x1b, 0x36, 0x64));
+            bg.setColorAt(1.0, QColor(0x16, 0x29, 0x4a));
+        } else {
+            bg.setColorAt(0.0, QColor(0x22, 0x26, 0x2c));
+            bg.setColorAt(1.0, QColor(0x1b, 0x1e, 0x23));
+        }
+        g.setPen(QPen(isDown() ? QColor(0x22, 0xd3, 0xee) : QColor(0x33, 0x37, 0x3f), 1));
+        g.setBrush(bg);
+        g.drawRoundedRect(r, 12, 12);
+
