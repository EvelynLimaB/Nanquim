+// miniatura da página do "Continuar"
+class PageThumb : public QWidget
+{
+public:
+    explicit PageThumb(QWidget *parent) : QWidget(parent) { setFixedSize(111, 156); }
+    void setIcon(const QIcon &icon) { m_icon = icon; update(); }
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter g(this);
+        g.setRenderHint(QPainter::Antialiasing);
+        g.setRenderHint(QPainter::SmoothPixmapTransform);
+        paintPage(&g, rect().adjusted(2, 0, -2, -6), m_icon, 8);
+    }
+private:
+    QIcon m_icon;
+};
