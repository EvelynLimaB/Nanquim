From b24a4011c7f213f1320987c2f4132d19a13b7864 Mon Sep 17 00:00:00 2001
From: Nanquim <nanquim@users.noreply.github.com>
Date: Wed, 25 Nov 2026 13:50:00 -0300
Subject: [PATCH] Nanquim: corrige compilação do 0133 a 0135

A build do 0133 a 0135 falhou:
- KisStorageModel::data() exige o papel; agora lê pela própria célula (index().data())
- KisResourceCacheDb::synchronizeStorage é privada: a organização dos pincéis logo
  depois de instalar (0135) sai. A saída mais curta da abertura continua

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fwRUYPpG2prvZV1MLpuhj
---
 libs/ui/NanquimTabletUi.cpp | 47 ++++-----------------------------------------
 1 file changed, 4 insertions(+), 43 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -114,8 +114,6 @@
 #include <KisResourceModel.h>
 #include <KisTagResourceModel.h>
 #include <KisStorageModel.h>
-#include <KisResourceCacheDb.h>
-#include <KisResourceStorage.h>
 #include "NanquimSutImport.h"
 #include <KisResourceUserOperations.h>
 #include <KoFileDialog.h>
@@ -2762,11 +2760,11 @@ int syncImportedBundleBrushes()
     QSet<int> userStorages;
     KisStorageModel *storages = KisStorageModel::instance();
     for (int r = 0; r < storages->rowCount(); ++r) {
-        const QString location = storages->data(storages->index(r, KisStorageModel::Location)).toString();
+        const QString location = storages->index(r, KisStorageModel::Location).data().toString();
         if (!location.endsWith(QLatin1String(".bundle"), Qt::CaseInsensitive)) continue;
-        if (storages->data(storages->index(r, KisStorageModel::PreInstalled)).toBool()) continue;
+        if (storages->index(r, KisStorageModel::PreInstalled).data().toBool()) continue;
         if (QFileInfo(location).fileName().contains(QLatin1String("Default_Resources"), Qt::CaseInsensitive)) continue;
-        userStorages.insert(storages->data(storages->index(r, KisStorageModel::Id)).toInt());
+        userStorages.insert(storages->index(r, KisStorageModel::Id).data().toInt());
     }
     if (userStorages.isEmpty()) return 0;
 
@@ -2792,42 +2790,6 @@ int syncImportedBundleBrushes()
     return toTag.size();
 }
 
-// Depois de instalar, organiza a pasta de pincéis já (com aviso), em vez de o Krita
-// fazer isso na próxima abertura: o log da build 92 mostrou ~1 min de abertura
-// logo depois de instalar vários pacotes. Várias instalações seguidas contam como uma.
-void scheduleBrushFolderResync(QWidget *parent)
-{
-    static QPointer<QTimer> timer;
-    static QPointer<KisMainWindow> lastMw;
-    if (KisMainWindow *mw = qobject_cast<KisMainWindow*>(parent ? parent->window() : nullptr)) lastMw = mw;
-    if (!timer) {
-        timer = new QTimer(qApp);
-        timer->setSingleShot(true);
-        timer->setInterval(2500);
-        QObject::connect(timer, &QTimer::timeout, qApp, []() {
-            if (lastMw) showToast(lastMw, i18n("Organizando pincéis…"));
-            // um respiro para o aviso aparecer antes do trabalho
-            QTimer::singleShot(120, qApp, []() {
-                QElapsedTimer t;
-                t.start();
-                KisStorageModel *storages = KisStorageModel::instance();
-                QVector<KisResourceStorageSP> folders;
-                for (int r = 0; r < storages->rowCount(); ++r) {
-                    KisResourceStorageSP st = storages->storageForIndex(storages->index(r, 0));
-                    if (st && st->type() == KisResourceStorage::StorageType::Folder) folders << st;
-                }
-                for (const KisResourceStorageSP &st : folders) {
-                    KisResourceCacheDb::synchronizeStorage(st);
-                }
-                KisUsageLogger::log(QStringLiteral("[Nanquim tempo] pincéis organizados depois de instalar (%1 pasta(s)) - %2 ms")
-                                    .arg(folders.size()).arg(t.elapsed()));
-                if (lastMw) showToast(lastMw, i18n("Pincéis prontos"));
-            });
-        });
-    }
-    timer->start();
-}
-
 // Instala um pincel ou pacote sem abrir caixa de mensagem nenhuma (as caixas nativas
 // saem quebradas no Android). Quem chama mostra o resultado no próprio botão ou num aviso.
 bool importBrushFileQuietly(QWidget *parent, const QString &path, QString *message)
@@ -2856,7 +2818,7 @@ bool importBrushFileQuietly(QWidget *parent, const QString &path, QString *messa
         // reinstalar um pacote que já está aí não é erro
         KisStorageModel *storages = KisStorageModel::instance();
         for (int r = 0; r < storages->rowCount() && !ok; ++r) {
-            const QString location = storages->data(storages->index(r, KisStorageModel::Location)).toString();
+            const QString location = storages->index(r, KisStorageModel::Location).data().toString();
             if (QFileInfo(location).fileName().compare(info.fileName(), Qt::CaseInsensitive) == 0) ok = true;
         }
         if (!ok) ok = KisStorageModel::instance()->importStorage(path, KisStorageModel::None);
@@ -2866,7 +2828,6 @@ bool importBrushFileQuietly(QWidget *parent, const QString &path, QString *messa
         msg = i18n("%1 não é um pincel que o Nanquim abre (.kpp, .bundle, .sut ou .zip).", info.fileName());
     }
     syncImportedBundleBrushes();
-    if (ok) scheduleBrushFolderResync(parent);
     KisUsageLogger::log(QStringLiteral("[Nanquim] importação silenciosa %1: %2").arg(info.fileName()).arg(ok ? "ok" : "falhou"));
     if (message) *message = msg;
     return ok;
