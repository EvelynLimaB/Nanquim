+// cartão de desenho recente da tela inicial
+class RecentCard : public QAbstractButton
+{
+public:
+    explicit RecentCard(QWidget *parent) : QAbstractButton(parent)
+    {
+        setFocusPolicy(Qt::NoFocus);
+        setFixedHeight(184);
+        setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+    }
+    void set(const QString &path, const QString &name, const QString &sub, const QIcon &icon)
+    {
+        m_path = path; m_name = name; m_sub = sub; m_icon = icon;
+        update();
+    }
+    QString path() const { return m_path; }
+    void setIcon2(const QIcon &icon) { m_icon = icon; update(); }
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter g(this);
+        g.setRenderHint(QPainter::Antialiasing);
+        g.setRenderHint(QPainter::SmoothPixmapTransform);
+        const QRectF card = QRectF(rect()).adjusted(0.5, 0.5, -0.5, -0.5);
+        g.setPen(QPen(isDown() ? QColor(0x3d, 0x8b, 0xff) : QColor(0x2a, 0x2e, 0x35), 1));
+        g.setBrush(isDown() ? QColor(0x22, 0x26, 0x2c) : QColor(0x1b, 0x1e, 0x23));
+        g.drawRoundedRect(card, 14, 14);
+        const QRect area = rect().adjusted(10, 10, -10, -56);
+        g.setPen(Qt::NoPen);
+        g.setBrush(QColor(0x15, 0x17, 0x1b));
+        g.drawRoundedRect(area, 8, 8);
+        paintPage(&g, area.adjusted(8, 6, -8, -6), m_icon, 4);
+        QFont f = font();
+        f.setPixelSize(15);
+        f.setWeight(QFont::DemiBold);
+        g.setFont(f);
+        g.setPen(C_TEXT);
+        const QRect t1(12, area.bottom() + 8, width() - 24, 20);
+        g.drawText(t1, Qt::AlignLeft | Qt::AlignVCenter, QFontMetrics(f).elidedText(m_name, Qt::ElideRight, t1.width()));
+        QFont s = font();
+        s.setPixelSize(13);
+        g.setFont(s);
+        g.setPen(QColor(0xa4, 0xa9, 0xb3));
+        const QRect t2(12, t1.bottom() + 2, width() - 24, 18);
+        g.drawText(t2, Qt::AlignLeft | Qt::AlignVCenter, QFontMetrics(s).elidedText(m_sub, Qt::ElideRight, t2.width()));
+    }
+private:
+    QString m_path, m_name, m_sub;
+    QIcon m_icon;
+};
