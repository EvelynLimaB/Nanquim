Subject: =?utf-8?q?=5BPATCH=5D_Nanquim=3A_blocos_de_textura_OpenGL_de_512_px_por_padr?=
 =?utf-8?q?=C3=A3o_no_Android?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Sobe o padrão de KisConfig::openGLTextureSize de 256 para 512 px no Android,
  reduzindo em 4 vezes as chamadas de upload na GPU ao mover e pintar páginas
  de quadrinhos em alta resolução
---
 libs/ui/kis_config.cc |   8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/libs/ui/kis_config.cc b/libs/ui/kis_config.cc
index 468ea1e579..afc4ea1af6 100644
--- a/libs/ui/kis_config.cc
+++ b/libs/ui/kis_config.cc
@@ -1145,7 +1145,13 @@
 
 int KisConfig::openGLTextureSize(bool defaultValue) const
 {
-    return (defaultValue ? 256 : m_cfg.readEntry("textureSize", 256));
+#ifdef Q_OS_ANDROID
+    // Nanquim: blocos de 512 px reduzem em 4x os uploads na GPU em páginas grandes
+    const int fallback = 512;
+#else
+    const int fallback = 256;
+#endif
+    return (defaultValue ? fallback : m_cfg.readEntry("textureSize", fallback));
 }
 
 bool KisConfig::forceOpenGLFenceWorkaround(bool defaultValue) const
