From 70e7beefcfec8f3d08bcbbd63ed816b7377df592 Mon Sep 17 00:00:00 2001
From: Nanquim <nanquim@users.noreply.github.com>
Date: Wed, 18 Nov 2026 16:08:08 -0300
Subject: [PATCH 96/97] Nanquim: tira a meta do dia da tela inicial
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

O anel com a contagem de páginas prontas no dia (e a troca da meta ao
tocar nele) sai do cartão Continuar. A marcação de etapas dos capítulos
continua igual.
---
 libs/ui/NanquimTabletUi.cpp | 133 ------------------------------------
 1 file changed, 133 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index 2ae0636..7c7198f 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -63,7 +63,6 @@
 #include <QTouchEvent>
 #include <QGridLayout>
 #include <QPropertyAnimation>
-#include <QDate>
 #include <QScrollArea>
 #include <QScrollBar>
 #include <QComboBox>
@@ -6350,37 +6349,6 @@ struct PagePreset {
 // Capítulos: grupos de páginas, guardados nas configurações do app.
 // Só guardam o caminho de cada desenho; os arquivos continuam onde estão.
 // ---------------------------------------------------------------------------
-// ---------------------------------------------------------------------------
-// Meta do dia: quantas páginas viraram "Pronta" hoje. O contador zera sozinho
-// quando o dia muda. A meta (1 a 6 páginas) troca com um toque no anel.
-// ---------------------------------------------------------------------------
-QString goalToday()
-{
-    return QDate::currentDate().toString(Qt::ISODate);
-}
-
-int goalTarget()
-{
-    return qBound(1, KSharedConfig::openConfig()->group("NanquimGoal").readEntry("target", 2), 6);
-}
-
-QStringList goalPages()
-{
-    KConfigGroup c = KSharedConfig::openConfig()->group("NanquimGoal");
-    if (c.readEntry("day", QString()) != goalToday()) return QStringList();
-    return c.readEntry("pages", QStringList());
-}
-
-void goalMark(const QString &path, bool done)
-{
-    KConfigGroup c = KSharedConfig::openConfig()->group("NanquimGoal");
-    QStringList pages = goalPages();
-    if (done && !pages.contains(path)) pages << path;
-    if (!done) pages.removeAll(path);
-    c.writeEntry("day", goalToday());
-    c.writeEntry("pages", pages);
-}
-
 class ChapterStore : public QObject
 {
 public:
@@ -6465,9 +6433,6 @@ public:
     }
     void setStatus(const QString &id, const QString &path, int value)
     {
-        const int old = status(id, path);
-        if (value == 2 && old != 2) goalMark(path, true);
-        if (value != 2 && old == 2) goalMark(path, false);
         KConfigGroup c = KSharedConfig::openConfig()->group(QStringLiteral("NanquimChapter-") + id);
         QStringList list = c.readEntry("status", QStringList());
         for (int i = list.size() - 1; i >= 0; --i) {
@@ -6699,103 +6664,6 @@ const PagePreset CHAPTER_FORMATS[] = {
 const int CHAPTER_FORMAT_COUNT = int(sizeof(CHAPTER_FORMATS) / sizeof(CHAPTER_FORMATS[0]));
 
 // recentes com filtro "sem capítulo" além da busca
-// anel da meta do dia, no cartão "Continuar"
-class GoalRing : public QWidget
-{
-public:
-    explicit GoalRing(QWidget *parent) : QWidget(parent)
-    {
-        setObjectName(QStringLiteral("nanquimGoalRing"));
-        setFixedSize(132, 156);
-        setCursor(Qt::PointingHandCursor);
-        setToolTip(i18n("Meta de páginas prontas por dia. Toque para mudar."));
-        m_anim.setDuration(520);
-        m_anim.setEasingCurve(softSpring());
-        QObject::connect(&m_anim, &QVariantAnimation::valueChanged, this, [this](const QVariant &v) {
-            m_shown = v.toReal();
-            update();
-        });
-        QPointer<GoalRing> guard(this);
-        ChapterStore::instance()->listeners << [guard]() { if (guard) guard->refresh(); };
-        refresh(false);
-    }
-
-    void refresh(bool animate = true)
-    {
-        m_done = goalPages().size();
-        m_target = goalTarget();
-        const qreal to = qMin(1.0, qreal(m_done) / m_target);
-        if (animate && isVisible()) {
-            m_anim.stop();
-            m_anim.setStartValue(m_shown);
-            m_anim.setEndValue(to);
-            m_anim.start();
-        } else {
-            m_shown = to;
-            update();
-        }
-    }
-
-protected:
-    void showEvent(QShowEvent *e) override
-    {
-        QWidget::showEvent(e);
-        refresh(false);   // o dia pode ter virado
-    }
-    void mousePressEvent(QMouseEvent *e) override
-    {
-        m_press = e->pos();
-    }
-    void mouseReleaseEvent(QMouseEvent *e) override
-    {
-        // arrastar (rolar a tela inicial) não troca a meta
-        if (!rect().contains(e->pos()) || (e->pos() - m_press).manhattanLength() > 16) return;
-        const int next = m_target >= 6 ? 1 : m_target + 1;
-        KSharedConfig::openConfig()->group("NanquimGoal").writeEntry("target", next);
-        refresh();
-    }
-    void paintEvent(QPaintEvent *) override
-    {
-        QPainter g(this);
-        g.setRenderHint(QPainter::Antialiasing);
-        const QRectF ring(20, 4, 92, 92);
-        g.setPen(QPen(Cor::LINHA, 9, Qt::SolidLine, Qt::FlatCap));
-        g.setBrush(Qt::NoBrush);
-        g.drawEllipse(ring);
-        const bool reached = m_done >= m_target;
-        if (m_shown > 0.001) {
-            QLinearGradient grad(ring.topLeft(), ring.bottomRight());
-            grad.setColorAt(0.0, reached ? Cor::VERDE : Cor::CIANO);
-            grad.setColorAt(1.0, reached ? Cor::CIANO : Cor::AZUL);
-            g.setPen(QPen(QBrush(grad), 9, Qt::SolidLine, Qt::RoundCap));
-            g.drawArc(ring, 90 * 16, -qRound(qBound(0.0, m_shown, 1.05) * 360 * 16));
-        }
-        QFont big = font();
-        big.setPixelSize(22);
-        big.setWeight(QFont::Bold);
-        g.setFont(big);
-        g.setPen(Cor::TEXTO);
-        g.drawText(ring, Qt::AlignCenter, QStringLiteral("%1/%2").arg(m_done).arg(m_target));
-        QFont small = font();
-        small.setPixelSize(12);
-        small.setWeight(QFont::DemiBold);
-        g.setFont(small);
-        g.setPen(reached ? Cor::VERDE : Cor::TEXTO_SUAVE);
-        const int left = m_target - m_done;
-        const QString line = reached ? i18n("Meta batida")
-                                     : (left == 1 ? i18n("Falta 1 página") : i18n("Faltam %1 páginas", left));
-        g.drawText(QRect(0, 104, width(), 20), Qt::AlignCenter, i18n("Meta de hoje"));
-        g.drawText(QRect(0, 124, width(), 20), Qt::AlignCenter, line);
-    }
-
-private:
-    QVariantAnimation m_anim;
-    qreal m_shown = 0.0;
-    int m_done = 0;
-    int m_target = 2;
-    QPoint m_press;
-};
-
 class RecentsFilter : public QSortFilterProxyModel
 {
 public:
@@ -7041,7 +6909,6 @@ QWidget *buildGallery(KisMainWindow *mw)
     }
     ctext->addStretch(1);
     col->addLayout(ctext, 1);
-    col->addWidget(new GoalRing(cont), 0, Qt::AlignVCenter);
     QVBoxLayout *cbtn = new QVBoxLayout();
     cbtn->setSpacing(12);
     cbtn->addStretch(1);
