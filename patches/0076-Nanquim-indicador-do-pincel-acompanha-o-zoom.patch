From a70fed0e976c5b3aa5fa5124650abcfdadac19ae Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Tue, 17 Nov 2026 21:25:55 -0300
Subject: [PATCH] =?UTF-8?q?Nanquim:=20indicador=20do=20pincel=20acompanha?=
 =?UTF-8?q?=20o=20zoom=20da=20p=C3=A1gina?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- O círculo do indicador (HUD) agora usa o zoom da página, mostrando
  o tamanho que o traço terá de fato na tela
- O texto continua mostrando o tamanho real do pincel em px
---
 libs/ui/NanquimTabletUi.cpp | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index 6d96d5a..08d1eef 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -149,6 +149,8 @@
 #include "KisView.h"
 #include "KisViewManager.h"
 #include "kis_canvas_resource_provider.h"
+#include "canvas/kis_canvas2.h"
+#include "canvas/kis_coordinates_converter.h"
 #include "KisUsageLogger.h"
 
 // KisApplication.cpp: instala .kpp, .bundle e .sut
@@ -3908,7 +3910,8 @@ public:
         hide();
     }
 
-    void flash(qreal brushPx, qreal opacityNorm, bool erasing)
+    // brushPx = tamanho real do pincel; screenPx = o mesmo tamanho já com o zoom da página
+    void flash(qreal brushPx, qreal screenPx, qreal opacityNorm, bool erasing)
     {
         if (!m_mw) return;
         QWidget *central = m_mw->centralWidget();
@@ -3916,7 +3919,7 @@ public:
         setGeometry(QRect(central->mapTo(m_mw, QPoint(0, 0)), central->size()));
 
         m_rawPx = qBound(1.0, brushPx, 1000.0);
-        m_diameter = qBound(6.0, m_rawPx, qMin(width(), height()) * 0.65);
+        m_diameter = qBound(6.0, screenPx, qMin(width(), height()) * 0.65);
         m_opacity = qBound(0.01, opacityNorm, 1.0);
         m_erasing = erasing;
 
@@ -3985,7 +3988,18 @@ void showBrushHud(KisMainWindow *mw)
     }
     const QVariant s = r->resource(KoCanvasResource::Size);
     const QVariant o = r->resource(KoCanvasResource::Opacity);
-    hud->flash(s.isValid() ? s.toReal() : 10.0, o.isValid() ? o.toReal() : 1.0, erasing);
+    const qreal px = s.isValid() ? s.toReal() : 10.0;
+    // o círculo acompanha o zoom: mostra o tamanho que o traço terá na tela
+    qreal zoom = 1.0;
+    if (KisViewManager *vm = mw->viewManager()) {
+        if (KisCanvas2 *canvas = vm->canvasBase()) {
+            if (const KisCoordinatesConverter *conv = canvas->coordinatesConverter()) {
+                const qreal z = conv->effectiveZoom();
+                if (z > 0.0) zoom = z;
+            }
+        }
+    }
+    hud->flash(px, px * zoom, o.isValid() ? o.toReal() : 1.0, erasing);
 }
 
 struct ToolEntry {
