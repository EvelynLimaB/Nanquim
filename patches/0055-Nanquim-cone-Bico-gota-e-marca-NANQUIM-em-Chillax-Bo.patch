+    "<path d='M22 5h20c4 8 11 16 11 25 0 12-13 22-21 30-8-8-21-18-21-30 0-9 7-17 11-25z' fill='url(#g)'/>"
+    "<path d='M32 36v22' stroke='#0d1420' stroke-width='3.4' stroke-linecap='round'/>"
+    "<circle cx='32' cy='28' r='4.6' fill='#0d1420'/></svg>";
 
 const char *GALLERY_STYLE =
     "QWidget#nanquimGallery, QWidget#nanquimHomePage, QWidget#nanquimChapterPage { background: #0e0f12; }"
@@ -4457,8 +4491,9 @@ QWidget *buildGallery(KisMainWindow *mw)
