+// ---------------------------------------------------------------------------
+// Pairar da S Pen: o ícone sob a caneta cresce um pouco, ganha um fundo
+// discreto e mostra o nome depois de ~350 ms. Vale para a barra do topo, a
+// barra lateral, o dock do polegar e as linhas da lista de pincéis.
+// ---------------------------------------------------------------------------
+class PenHover : public QObject
+{
+public:
+    explicit PenHover(KisMainWindow *mw) : QObject(mw), m_mw(mw)
+    {
+        m_tip.setSingleShot(true);
+        m_tip.setInterval(350);
+        QObject::connect(&m_tip, &QTimer::timeout, this, [this]() {
+            if (!m_button || m_button->toolTip().isEmpty()) return;
+            const QRect r(m_button->mapToGlobal(QPoint(0, 0)), m_button->size());
+            QPoint at = r.bottomLeft() + QPoint(0, 6);
+            QWidget *nav = m_mw ? m_mw->findChild<QWidget*>(QStringLiteral("nanquimTools")) : nullptr;
+            if (nav && nav->isAncestorOf(m_button)) {
+                at = railOnRight() ? r.topLeft() + QPoint(-8 - r.width() * 2, r.height() / 4) : r.topRight() + QPoint(8, r.height() / 4);
+            }
+            QToolTip::showText(at, m_button->toolTip(), m_button);
+        });
+    }
+protected:
+    bool eventFilter(QObject *, QEvent *e) override
+    {
+        const QEvent::Type t = e->type();
+        if (t == QEvent::TabletLeaveProximity || t == QEvent::TabletPress || t == QEvent::TouchBegin) {
+            clear();
+            return false;
+        }
+        QPoint global;
+        if (t == QEvent::TabletMove) {
+            QTabletEvent *te = static_cast<QTabletEvent*>(e);
+            if (te->buttons() != Qt::NoButton || te->pressure() > 0) { clear(); return false; }
+            global = te->globalPos();
+        } else if (t == QEvent::MouseMove) {
+            QMouseEvent *me = static_cast<QMouseEvent*>(e);
+            if (me->buttons() != Qt::NoButton) return false;
+            global = me->globalPos();
+        } else {
+            return false;
+        }
+        if (global == m_last) return false;
+        m_last = global;
+        track(global);
+        return false;
+    }
+private:
+    bool inNanquimBar(QWidget *w) const
+    {
+        for (QWidget *p = w; p && p != m_mw; p = p->parentWidget()) {
+            const QString n = p->objectName();
+            if (n == QLatin1String("nanquimTop") || n == QLatin1String("nanquimTools")
+                    || n == QLatin1String("nanquimThumbDock") || n == QLatin1String("nanquimQuickColors")
+                    || n == QLatin1String("nanquimFocusBar") || n == QLatin1String("nanquimPanelHeader")) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    void track(const QPoint &global)
+    {
+        if (!m_mw) return;
+        QWidget *w = qApp->widgetAt(global);
+        if (!w || w->window() != m_mw) { clear(); return; }
+        // botão
+        QToolButton *b = nullptr;
+        for (QWidget *p = w; p && p != m_mw; p = p->parentWidget()) {
+            if ((b = qobject_cast<QToolButton*>(p))) break;
+        }
+        if (b && !inNanquimBar(b) && b->objectName() != QLatin1String("nanquimSwatch")) b = nullptr;
+        if (b != m_button) {
+            setButton(b);
+        }
+        // linha da lista de pincéis
+        QListView *list = nullptr;
+        if (!b) {
+            for (QWidget *p = w; p && p != m_mw; p = p->parentWidget()) {
+                if ((list = qobject_cast<QListView*>(p))) break;
+            }
+            if (list && !list->property("nanquimHoverRows").toBool()) list = nullptr;
+        }
+        int row = -1;
+        if (list) row = list->indexAt(list->viewport()->mapFromGlobal(global)).row();
+        if (list != m_list || row != m_row) {
+            if (m_list && m_list != list) {
+                m_list->setProperty("nanquimHoverRow", -1);
+                m_list->viewport()->update();
+            }
+            m_list = list;
+            m_row = row;
+            if (m_list) {
+                m_list->setProperty("nanquimHoverRow", row);
+                m_list->viewport()->update();
+            }
+        }
+    }
+
+    void setButton(QToolButton *b)
+    {
+        m_tip.stop();
+        QToolTip::hideText();
+        if (m_button) {
+            const QSize orig = m_button->property("nanquimHoverIcon").toSize();
+            if (orig.isValid()) m_button->setIconSize(orig);
+            if (m_button->property("nanquimHoverFixed").toBool()) {
+                m_button->setMinimumSize(m_button->property("nanquimHoverMin").toSize());
+                m_button->setMaximumSize(m_button->property("nanquimHoverMax").toSize());
+                m_button->setProperty("nanquimHoverFixed", false);
+            }
+            m_button->setProperty("nanquimHover", false);
+            m_button->style()->unpolish(m_button);
+            m_button->style()->polish(m_button);
+        }
+        m_button = b;
+        if (!b || !b->isEnabled()) {
+            m_button = nullptr;
+            return;
+        }
+        // o botão não muda de tamanho: só o ícone cresce dentro dele
+        if (b->minimumSize() != b->maximumSize()) {
+            b->setProperty("nanquimHoverMin", b->minimumSize());
+            b->setProperty("nanquimHoverMax", b->maximumSize());
+            b->setFixedSize(b->size());
+            b->setProperty("nanquimHoverFixed", true);
+        }
+        const QSize orig = b->iconSize();
+        b->setProperty("nanquimHoverIcon", orig);
+        if (b->objectName() != QLatin1String("nanquimSwatch")) {
+            b->setIconSize(QSize(qRound(orig.width() * 1.15), qRound(orig.height() * 1.15)));
+        }
+        b->setProperty("nanquimHover", true);
+        b->style()->unpolish(b);
+        b->style()->polish(b);
+        m_tip.start();
+    }
+
+    void clear()
+    {
+        m_last = QPoint();
+        if (m_button) setButton(nullptr);
+        m_tip.stop();
+        if (m_list) {
+            m_list->setProperty("nanquimHoverRow", -1);
+            m_list->viewport()->update();
+            m_list = nullptr;
+            m_row = -1;
+        }
+    }
+
+    QPointer<KisMainWindow> m_mw;
+    QPointer<QToolButton> m_button;
+    QPointer<QListView> m_list;
+    int m_row = -1;
+    QPoint m_last;
+    QTimer m_tip;
+};
+
 void installPanelBehavior(KisMainWindow *mw)
 {
     qApp->installEventFilter(new PanelCloser(mw));
+    qApp->installEventFilter(new PenHover(mw));
     mw->installEventFilter(new PanelHostWatcher(mw));
 }
 
