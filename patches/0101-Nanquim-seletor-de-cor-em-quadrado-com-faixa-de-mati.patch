From cbbcee05565b9435da73d1b2f481013fb12a8c28 Mon Sep 17 00:00:00 2001
From: Nanquim <nanquim@users.noreply.github.com>
Date: Wed, 18 Nov 2026 22:35:46 -0300
Subject: [PATCH 101/105] Nanquim: seletor de cor em quadrado com faixa de
 matiz
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

O painel de cor troca o anel com triângulo por um quadrado de saturação
e brilho, com a faixa de matiz em cima, como no redesenho. Os títulos do
painel ficam mais curtos.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fwRUW9SkxqcJFLYxLRXTf
---
 libs/ui/NanquimTabletUi.cpp | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index bb99df2..77bf78f 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -82,6 +82,7 @@
 #include <QDesktopServices>
 #include <QRegularExpression>
 #include <KisVisualColorSelector.h>
+#include <KisColorSelectorConfiguration.h>
 #include <KoColorSpace.h>
 #include "kis_display_color_converter.h"
 #include <kis_config_notifier.h>
@@ -9323,7 +9324,7 @@ QDockWidget *buildColorDock(KisMainWindow *mw)
     root->setSpacing(12);
 
     QHBoxLayout *head = new QHBoxLayout();
-    head->addWidget(nqLabel(i18n("COR"), "nqSection", body), 1);
+    head->addWidget(nqLabel(i18n("Cor"), "nqSection", body), 1);
     QPushButton *picker = nqButton(QString(), body, "nqGhost");
     picker->setIcon(designIcon(Svg::PICKER, 20));
     picker->setToolTip(i18n("Conta-gotas"));
@@ -9334,7 +9335,16 @@ QDockWidget *buildColorDock(KisMainWindow *mw)
     KisVisualColorSelector *selector = new KisVisualColorSelector(body);
     selector->setAcceptTabletEvents(true);
     selector->setDisplayRenderer(KisDisplayColorConverter::dumbConverterInstance()->displayRendererInterface());
-    selector->setConfig(true, false);
+    // redesenho: quadrado de saturação e brilho, com a faixa de matiz em cima
+    selector->setConfig(false, false);
+    {
+        const KisColorSelectorConfiguration squareHue(KisColorSelectorConfiguration::Square,
+                                                      KisColorSelectorConfiguration::Slider,
+                                                      KisColorSelectorConfiguration::SV,
+                                                      KisColorSelectorConfiguration::H);
+        selector->setConfiguration(&squareHue);
+        selector->setSliderPosition(Qt::TopEdge);
+    }
     selector->setMinimumSize(220, 220);
     selector->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Expanding);
     root->addWidget(selector, 1);
@@ -9366,7 +9376,7 @@ QDockWidget *buildColorDock(KisMainWindow *mw)
     ink->addStretch(1);
     root->addLayout(ink);
 
-    root->addWidget(nqLabel(i18n("Cinzas para mangá · 10 a 90%"), "nqSmall", body));
+    root->addWidget(nqLabel(i18n("Cinzas para mangá"), "nqSmall", body));
     QGridLayout *grays = new QGridLayout();
     grays->setSpacing(4);
     for (int i = 1; i <= 9; i++) {
