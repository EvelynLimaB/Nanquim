 protected:
+    void setPress(bool down)
+    {
+        if (!m_pressAnim) {
+            m_pressAnim = new QVariantAnimation(this);
+            QObject::connect(m_pressAnim, &QVariantAnimation::valueChanged, this, [this](const QVariant &v) {
+                m_press = v.toReal();
+                update();
+            });
+        }
+        m_pressAnim->stop();
+        m_pressAnim->setStartValue(m_press);
+        m_pressAnim->setEndValue(down ? 1.0 : 0.0);
+        m_pressAnim->setDuration(down ? 85 : 220);
+        m_pressAnim->setEasingCurve(down ? QEasingCurve::OutQuad : softSpring());
+        m_pressAnim->start();
+    }
+    void mousePressEvent(QMouseEvent *e) override { QAbstractButton::mousePressEvent(e); if (isDown()) setPress(true); }
+    void mouseReleaseEvent(QMouseEvent *e) override { QAbstractButton::mouseReleaseEvent(e); setPress(false); }
     void paintEvent(QPaintEvent *) override
     {
         QPainter g(this);
         g.setRenderHint(QPainter::Antialiasing);
-        g.setPen(QPen(isDown() ? QColor(0x3d, 0x8b, 0xff) : QColor(0x3a, 0x3f, 0x48), 1));
-        g.setBrush(isDown() ? QColor(0x22, 0x26, 0x2c) : QColor(0x1b, 0x1e, 0x23));
-        g.drawRoundedRect(QRectF(rect()).adjusted(0.5, 0.5, -0.5, -0.5), 12, 12);
-        g.drawPixmap(16, (height() - 24) / 2, m_icon);
