@@ -15572,7 +15728,7 @@ void buildStudio(KisMainWindow *mw)
                 });
             }
             menu->addAction(designIcon(Svg::BRUSH, 18), i18n("Ajustes do pincel"), w, [w]() { showBrushSettings(w); });
-            QMenu *rulers = menu->addMenu(designIcon(Svg::RULER, 18), i18n("Réguas e mangá"));
