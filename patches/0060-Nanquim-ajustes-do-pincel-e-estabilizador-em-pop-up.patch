+// interruptor (liga/desliga) desenhado como no design
+class NqSwitch : public QAbstractButton
+{
+public:
+    explicit NqSwitch(QWidget *parent) : QAbstractButton(parent)
+    {
+        setCheckable(true);
+        setFixedSize(52, 32);
+        setFocusPolicy(Qt::NoFocus);
+    }
+    QSize sizeHint() const override { return QSize(52, 32); }
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter g(this);
+        g.setRenderHint(QPainter::Antialiasing);
+        g.setPen(Qt::NoPen);
+        if (isChecked()) {
+            QLinearGradient grad(0, 0, width(), 0);
+            grad.setColorAt(0, QColor(0x3d, 0x8b, 0xff));
+            grad.setColorAt(1, QColor(0x22, 0xd3, 0xee));
+            g.setBrush(grad);
+        } else {
+            g.setBrush(QColor(0x3a, 0x3f, 0x48));
+        }
+        g.drawRoundedRect(rect(), 16, 16);
+        g.setBrush(isChecked() ? QColor(0x0b, 0x12, 0x20) : QColor(0xec, 0xee, 0xf2));
+        g.drawEllipse(QRectF(isChecked() ? 24 : 4, 4, 24, 24));
+    }
+};
