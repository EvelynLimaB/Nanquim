Subject: [PATCH 94/97] =?UTF-8?q?Nanquim:=20pain=C3=A9is=20da=20tela=20de?=
 =?UTF-8?q?=20desenho=20n=C3=A3o=20se=20cobrem=20mais?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

O painel Ferramentas abre ao lado da coluna do polegar (dock, 3 cores e
bolinha), em vez de ficar por baixo das cores. Na tela cheia, quando não
há altura para a cápsula de ferramentas ficar em cima das 3 cores, ela vai
para o lado de dentro da coluna, sem cobrir as cores.
---
 libs/ui/NanquimTabletUi.cpp | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index d598dec..c04369a 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -3809,7 +3809,15 @@ void placeFlyout(KisMainWindow *mw, QFrame *flyout)
                                                   : flyout->sizeHint().height();
     const int h = qMin(want, central->height() - 2 * margin);
     const int w = flyout->sizeHint().width();
-    const int x = railOnRight() ? origin.x() + central->width() - margin - w : origin.x() + margin;
+    int x = railOnRight() ? origin.x() + central->width() - margin - w : origin.x() + margin;
+    // a coluna do polegar (dock, 3 cores e bolinha) fica na mesma borda: o painel
+    // abre ao lado dela, e não por baixo (antes as cores cobriam as ferramentas)
+    for (const char *id : {"nanquimThumbDock", "nanquimQuickColors", "nanquimSwatch"}) {
+        QWidget *wdg = mw->findChild<QWidget*>(QLatin1String(id));
+        if (!wdg || !wdg->isVisible() || wdg == flyout) continue;
+        if (railOnRight()) x = qMin(x, wdg->x() - margin - w);
+        else x = qMax(x, wdg->x() + wdg->width() + margin);
+    }
     flyout->setGeometry(x, origin.y() + margin, w, h);
 }
 
@@ -4712,6 +4720,13 @@ void placeFocusWidgets(KisMainWindow *mw)
         if (ref) {
             x = ref->x() + (ref->width() - bar->width()) / 2;
             y = ref->y() - 12 - bar->height();
+            if (y < area.top() + 56) {
+                // sem altura para ficar em cima das cores: a cápsula vai para o lado
+                // de dentro da coluna, em vez de cobrir as 3 cores
+                QWidget *col = (dock && dock->isVisible()) ? static_cast<QWidget*>(dock) : ref;
+                x = right ? col->x() - 12 - bar->width() : col->x() + col->width() + 12;
+                y = area.top() + 56;
+            }
         }
         bar->move(x, qMax(area.top() + 56, y));
         bar->raise();
