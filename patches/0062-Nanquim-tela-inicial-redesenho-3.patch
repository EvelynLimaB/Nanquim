+// formato da faixa "Nova página" no rodapé
+class PresetButton : public QAbstractButton
+{
+public:
+    PresetButton(const QString &title, const QString &detail, const char *svg, QWidget *parent)
+        : QAbstractButton(parent), m_title(title), m_detail(detail),
+          m_icon(svgPixmap(QString::fromUtf8(svg), QColor(0x6a, 0xa6, 0xff), 24))
+    {
+        setFocusPolicy(Qt::NoFocus);
+        setFixedHeight(56);
+        setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+        setToolTip(title);
+    }
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter g(this);
+        g.setRenderHint(QPainter::Antialiasing);
+        g.setPen(QPen(isDown() ? QColor(0x3d, 0x8b, 0xff) : QColor(0x3a, 0x3f, 0x48), 1));
+        g.setBrush(isDown() ? QColor(0x22, 0x26, 0x2c) : QColor(0x1b, 0x1e, 0x23));
+        g.drawRoundedRect(QRectF(rect()).adjusted(0.5, 0.5, -0.5, -0.5), 12, 12);
+        g.drawPixmap(16, (height() - 24) / 2, m_icon);
+        QFont f = font();
+        f.setPixelSize(15);
+        f.setWeight(QFont::DemiBold);
+        g.setFont(f);
+        g.setPen(C_TEXT);
+        const int x = 52;
+        g.drawText(QRect(x, 8, width() - x - 10, 20), Qt::AlignLeft | Qt::AlignVCenter,
+                   QFontMetrics(f).elidedText(m_title, Qt::ElideRight, width() - x - 10));
+        QFont s = font();
+        s.setPixelSize(13);
+        g.setFont(s);
+        g.setPen(QColor(0xa4, 0xa9, 0xb3));
+        g.drawText(QRect(x, 28, width() - x - 10, 18), Qt::AlignLeft | Qt::AlignVCenter,
+                   QFontMetrics(s).elidedText(m_detail, Qt::ElideRight, width() - x - 10));
+    }
+private:
+    QString m_title, m_detail;
+    QPixmap m_icon;
+};
