+// as barras do Krita que o estúdio substitui: abas dos documentos e barra de status
+void hideKritaChrome(KisMainWindow *mw)
+{
+    if (QStatusBar *sb = mw->statusBar()) {
+        if (!sb->property("nanquimHidden").toBool()) {
+            sb->setProperty("nanquimHidden", true);
+            sb->installEventFilter(new EventFn(sb, [](QObject *o, QEvent *e) {
+                if (e->type() == QEvent::Show && !isClassicMode()) {
+                    QPointer<QWidget> w(static_cast<QWidget*>(o));
+                    QTimer::singleShot(0, w.data(), [w]() { if (w) w->hide(); });
+                }
+                return false;
+            }));
+        }
+        sb->hide();
+    }
+    if (QWidget *central = mw->centralWidget()) {
+        Q_FOREACH (QTabBar *tabs, central->findChildren<QTabBar*>()) {
+            if (!tabs->property("nanquimHidden").toBool()) {
+                tabs->setProperty("nanquimHidden", true);
+                tabs->installEventFilter(new EventFn(tabs, [](QObject *o, QEvent *e) {
+                    if (e->type() == QEvent::Show && !isClassicMode()) {
+                        QPointer<QWidget> w(static_cast<QWidget*>(o));
+                        QTimer::singleShot(0, w.data(), [w]() { if (w) w->hide(); });
+                    }
+                    return false;
+                }));
+            }
+            tabs->hide();
+        }
+    }
+}
