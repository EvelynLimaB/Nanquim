No Android, entrar e sair da tela cheia não troca mais o estado da janela
(isso recriava a superfície e a tela ficava preta por um instante). As
barras do sistema continuam; somem só as barras do app. O aviso do Krita
em inglês ("Going into Canvas-Only mode") não aparece mais. Se a página
estava em "caber na tela", o zoom atual fica fixo antes de a área crescer,
e a página é deslocada para ficar no mesmo lugar.
---
 libs/ui/KisViewManager.cpp | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/libs/ui/KisViewManager.cpp b/libs/ui/KisViewManager.cpp
index a99c10a..7de7094 100644
--- a/libs/ui/KisViewManager.cpp
+++ b/libs/ui/KisViewManager.cpp
@@ -1279,11 +1279,29 @@ void KisViewManager::switchCanvasOnly(bool toggled)
         d->canvasOnlyOptions = options;
     }
 
+#ifdef Q_OS_ANDROID
+    // Nanquim: no Android, trocar o estado da janela para tela cheia recria a
+    // superfície e a tela fica preta por um instante. As barras do sistema
+    // ficam como estão; só as barras do app somem. A página também não deve
+    // mudar de zoom: se estava "caber na tela", o zoom atual fica fixo antes
+    // de a área da página crescer, e ela é deslocada para não pular.
+    const bool toggleFullscreen = false;
+    const bool useCanvasOffsetCompensation = d->currentImageView &&
+                                             d->currentImageView->canvasController() &&
+                                             !main->canvasDetached();
+    if (useCanvasOffsetCompensation) {
+        const KoZoomState zs = d->currentImageView->canvasController()->zoomState();
+        if (zs.mode == KoZoomMode::ZOOM_PAGE || zs.mode == KoZoomMode::ZOOM_WIDTH) {
+            d->currentImageView->canvasController()->setZoom(KoZoomMode::ZOOM_CONSTANT, zs.zoom);
+        }
+    }
+#else
     const bool toggleFullscreen = (options.hideTitlebarFullscreen && !cfg.fullscreenMode());
     const bool useCanvasOffsetCompensation = d->currentImageView &&
                                              d->currentImageView->canvasController() &&
                                              d->currentImageView->isMaximized() &&
                                              !main->canvasDetached();
+#endif
 
     if (useCanvasOffsetCompensation) {
         // The offset is calculated in two steps; this is the first step.
@@ -1427,11 +1445,13 @@ void KisViewManager::switchCanvasOnly(bool toggled)
             });
         }
 
+#ifndef Q_OS_ANDROID
                // show a fading heads-up display about the shortcut to go back
         showFloatingMessage(i18n("Going into Canvas-Only mode.\nPress %1 to go back.",
                                  actionCollection()->action("view_show_canvas_only")->shortcut().toString(QKeySequence::NativeText)), QIcon(),
                             2000,
                             KisFloatingMessage::Low);
+#endif
     }
     else {
         if (!d->canvasStateInNormalMode.isEmpty()) {
