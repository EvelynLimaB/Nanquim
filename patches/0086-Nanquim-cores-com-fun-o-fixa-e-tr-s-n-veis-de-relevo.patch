From f47f3d284b425aa7ff611863f1224a5839dec9d9 Mon Sep 17 00:00:00 2001
From: N <n@x>
Date: Wed, 18 Nov 2026 11:13:13 -0300
Subject: [PATCH 86/92] =?UTF-8?q?Nanquim:=20cores=20com=20fun=C3=A7=C3=A3o?=
 =?UTF-8?q?=20fixa=20e=20tr=C3=AAs=20n=C3=ADveis=20de=20relevo?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Namespace Cor com as seis cores de papel fixo (azul, ciano, coral, verde,
  âmbar, azul claro) e os neutros, comentadas no código
- Relevo em três níveis: barras planas; dock, cores rápidas e cápsula com brilho
  leve; pop-ups, pincéis, ferramentas, janelas e avisos com brilho forte e borda
  mais clara
---
 libs/ui/NanquimTabletUi.cpp | 52 +++++++++++++++++++++++++++++++------
 1 file changed, 44 insertions(+), 8 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index be53339..2f00251 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -170,6 +170,42 @@ const QColor C_MUTED(0xa3, 0xa3, 0xae);
 const QColor C_DISABLED(0x4a, 0x4a, 0x55);
 const QColor C_ACCENT(0x3d, 0x8b, 0xff);
 
+// ---------------------------------------------------------------------------
+// Cores com função fixa. Cada cor tem um papel só; patch novo usa estas, não
+// inventa outra (lista completa em docs/CORES.md do repositório).
+//   azul        ativo, seleção, borda de foco, botão principal
+//   ciano       toque, ferramenta ativa, trabalho em andamento, arte-final
+//   coral       borracha, erro, ação que apaga
+//   verde       pronto, salvo, concluído
+//   âmbar       rascunho, atenção
+//   azul claro  texto e ícone ativos, números de medida, vetor e texto
+// ---------------------------------------------------------------------------
+namespace Cor
+{
+const QColor AZUL(0x3d, 0x8b, 0xff);
+const QColor CIANO(0x22, 0xd3, 0xee);
+const QColor CORAL(0xff, 0x6b, 0x8b);
+const QColor VERDE(0x5e, 0xc9, 0x8c);
+const QColor AMBAR(0xe6, 0xb4, 0x5a);
+const QColor AZUL_CLARO(0x6a, 0xa6, 0xff);
+const QColor TEXTO(0xec, 0xee, 0xf2);
+const QColor TEXTO_SUAVE(0xa4, 0xa9, 0xb3);
+const QColor FUNDO(0x15, 0x17, 0x1b);
+const QColor LINHA(0x2a, 0x2e, 0x35);
+}
+
+// ---------------------------------------------------------------------------
+// Três níveis de relevo: quanto mais perto do dedo, mais brilho no topo e
+// mais clara a borda. O fundo é sempre #15171b, para o conteúdo combinar.
+//   nível 1  barras fixas (topo, lateral): plano, borda #2a2e35
+//   nível 2  peças sobre a página (dock, cores rápidas, cápsula, cartões)
+//   nível 3  pop-ups e janelas (painéis, pincéis, ferramentas, avisos)
+// ---------------------------------------------------------------------------
+#define NQ_RELEVO2_BG "qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(34,38,44,0.96), stop:0.22 rgba(21,23,27,0.95), stop:1 rgba(21,23,27,0.95))"
+#define NQ_RELEVO2_BORDA "#33373f"
+#define NQ_RELEVO3_BG "qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #272b33, stop:0.14 #15171b, stop:1 #15171b)"
+#define NQ_RELEVO3_BORDA "#3f4551"
+
 const QString TOP_ID = QStringLiteral("nanquimTop");
 const QString NAV_ID = QStringLiteral("nanquimTools");
 const QString OLD_TOP_ID = QStringLiteral("BrushesAndStuff");
@@ -512,7 +548,7 @@ const char *SVG_PIN = "<path d='M15 4.5l-4 4-4 1.5-1.5 1.5 7 7 1.5-1.5 1.5-4 4-4
 const char *SVG_CLOSE = "<path d='M6 6l12 12M18 6L6 18'/>";
 
 const char *PANEL_HOST_STYLE =
-    "QFrame#nanquimPanelHost { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1b1e23, stop:0.14 #15171b, stop:1 #15171b); border: 1px solid #33373f; border-radius: 16px; }"
+    "QFrame#nanquimPanelHost { background: " NQ_RELEVO3_BG "; border: 1px solid " NQ_RELEVO3_BORDA "; border-radius: 16px; }"
     "QWidget#nanquimPanelHeader { background: #15171b; }"
     "QWidget#nanquimPanelHeader QLabel { color: #eceef2; font-size: 16px; font-weight: 700; background: transparent; }"
     "QWidget#nanquimPanelHeader QToolButton { border: none; border-radius: 10px; padding: 0;"
@@ -2885,7 +2921,7 @@ const QString BRUSH_DOCK_ID = QStringLiteral("NanquimBrushDock");
 QPointer<NanquimOverlay> s_brushOverlay;
 
 const char *BRUSH_PANEL_STYLE =
-    "QFrame#nanquimBrushPanel { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1b1e23, stop:0.12 #15171b, stop:1 #15171b); border: 1px solid #33373f; border-radius: 16px; }"
+    "QFrame#nanquimBrushPanel { background: " NQ_RELEVO3_BG "; border: 1px solid " NQ_RELEVO3_BORDA "; border-radius: 16px; }"
     "QLabel#nanquimBrushTitle { color: #a4a9b3; font-size: 13px; font-weight: 700; letter-spacing: 2px; background: transparent; }"
     "QToolButton#nanquimBrushAdd { color: #eceef2; background: transparent; border: none; border-radius: 10px;"
     "  font-size: 24px; padding: 0px 8px 3px 8px; }"
@@ -3745,7 +3781,7 @@ QList<FlyoutGroup> flyoutGroups()
 }
 
 const char *FLYOUT_STYLE =
-    "QFrame#nanquimToolsFlyout { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1b1e23, stop:0.12 #15171b, stop:1 #15171b); border: 1px solid #33373f; border-radius: 16px; }"
+    "QFrame#nanquimToolsFlyout { background: " NQ_RELEVO3_BG "; border: 1px solid " NQ_RELEVO3_BORDA "; border-radius: 16px; }"
     "QFrame#nanquimToolsFlyout QScrollArea, QFrame#nanquimToolsFlyout QScrollArea > QWidget > QWidget"
     "  { background: transparent; border: none; }"
     "QLabel#nanquimFlyoutTitle { color: #eceef2; font-size: 16px; font-weight: 600; }"
@@ -4389,7 +4425,7 @@ const QString SWATCH_ID = QStringLiteral("nanquimSwatch");
 const char *SVG_HAND = "<path d='M8 13V5.5a1.5 1.5 0 0 1 3 0V12M11 11.5v-7a1.5 1.5 0 0 1 3 0V12M14 11.5V6a1.5 1.5 0 0 1 3 0v7.5M8 13.5l-1.6-2.2a1.6 1.6 0 0 0-2.5 2L8.5 19a5 5 0 0 0 4 2H14a5 5 0 0 0 5-5v-3.5'/>";
 
 const char *THUMB_STYLE =
-    "QFrame#nanquimThumbDock { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(34,38,44,0.96), stop:0.22 rgba(21,23,27,0.95), stop:1 rgba(21,23,27,0.95)); border: 1px solid #33373f; border-radius: 16px; }"
+    "QFrame#nanquimThumbDock { background: " NQ_RELEVO2_BG "; border: 1px solid " NQ_RELEVO2_BORDA "; border-radius: 16px; }"
     "QFrame#nanquimThumbDock QToolButton { border: none; border-radius: 12px; padding: 0;"
     "  min-width: 52px; max-width: 52px; min-height: 52px; max-height: 52px; }"
     "QFrame#nanquimThumbDock QToolButton:hover { background: rgba(255,255,255,0.06); }"
@@ -4599,7 +4635,7 @@ void buildQuickColors(KisMainWindow *mw)
     QFrame *bar = new QFrame(mw);
     bar->setObjectName(QUICK_COLORS_ID);
     bar->setStyleSheet(QStringLiteral(
-        "QFrame#nanquimQuickColors { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(34,38,44,0.96), stop:0.22 rgba(21,23,27,0.95), stop:1 rgba(21,23,27,0.95)); border: 1px solid #33373f; border-radius: 16px; }"
+        "QFrame#nanquimQuickColors { background: " NQ_RELEVO2_BG "; border: 1px solid " NQ_RELEVO2_BORDA "; border-radius: 16px; }"
         "QFrame#nanquimQuickColors QToolButton { border: none; border-radius: 12px; padding: 0; background: transparent; }"
         "QFrame#nanquimQuickColors QToolButton:pressed { background: #2a2e35; }"));
     QVBoxLayout *l = new QVBoxLayout(bar);
@@ -5143,7 +5179,7 @@ void buildFocusWidgets(KisMainWindow *mw)
     QFrame *bar = new QFrame(mw);
     bar->setObjectName(QStringLiteral("nanquimFocusBar"));
     bar->setStyleSheet(QStringLiteral(
-        "QFrame#nanquimFocusBar { background: rgba(34,38,44,0.92); border: 1px solid #33373f; border-radius: 28px; }"
+        "QFrame#nanquimFocusBar { background: " NQ_RELEVO2_BG "; border: 1px solid " NQ_RELEVO2_BORDA "; border-radius: 28px; }"
         "QFrame#nanquimFocusBar QToolButton { border: none; border-radius: 12px; padding: 0;"
         "  min-width: 48px; max-width: 48px; min-height: 48px; max-height: 48px; }"
         "QFrame#nanquimFocusBar QToolButton:pressed { background: #2a2e35; }"
@@ -7949,7 +7985,7 @@ void arrangeClassic(KisMainWindow *mw)
 // Folha de estilo comum às janelas do Nanquim: fundo #15171b, títulos de seção
 // em maiúsculas espaçadas, botão principal com o degradê da gota, chips em pílula.
 const char *SHEET_STYLE =
-    "QDialog#nanquimSheet { background: #15171b; border: 1px solid #2a2e35; border-radius: 18px; }"
+    "QDialog#nanquimSheet { background: " NQ_RELEVO3_BG "; border: 1px solid " NQ_RELEVO3_BORDA "; border-radius: 18px; }"
     "QDialog#nanquimSheet QLabel { color: #eceef2; background: transparent; }"
     "QLabel#nqSection { color: #a4a9b3; font-size: 13px; font-weight: 700; letter-spacing: 2px; }"
     "QLabel#nqTitle { font-size: 24px; font-weight: 700; }"
@@ -8087,7 +8123,7 @@ void showToast(KisMainWindow *mw, const QString &text)
     toast->setObjectName(QStringLiteral("nanquimToast"));
     toast->setAttribute(Qt::WA_TransparentForMouseEvents);
     toast->setStyleSheet(QStringLiteral(
-        "QFrame#nanquimToast { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1b1e23, stop:1 #15171b);"
+        "QFrame#nanquimToast { background: " NQ_RELEVO3_BG ";"
         "  border: 1px solid #3d8bff; border-radius: 24px; }"
         "QLabel { color: #eceef2; font-size: 14px; font-weight: 600; background: transparent; }"));
     QHBoxLayout *l = new QHBoxLayout(toast);
