+    "QSlider::sub-page:vertical { width: 6px; border-radius: 3px; background: #4a4842; }"
+    "QSlider::handle:vertical { height: 24px; width: 24px; margin: 0px -9px; border-radius: 12px; background: #eeeae0; }";
