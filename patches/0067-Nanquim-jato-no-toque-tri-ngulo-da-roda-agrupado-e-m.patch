Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Roda de atalhos: renderizar o triângulo a cada move do arrasto do matiz
  (um laço por pixel + repaint do widget todo a 120 Hz) passa a ser agrupado
  a ~33 Hz, com repaint só do triângulo e da etiqueta; a cor escolhida segue
  em tempo real e o último frame sai em crisp
- DPR do triângulo limitado a 2× (num gradiente não se vê; o laço cresce com
  o quadrado do DPR)
- Miniaturas de pincéis: teto de ~96 entradas (~3 MB) no cache, sem crescer
  sem limite com pacotes grandes
- Cartões da galeria: a animação de entrada roda uma vez, não a cada volta
  à tela inicial
- FlyoutCloser sem findChild a cada clique (ponteiros guardados)
---
 libs/ui/NanquimTabletUi.cpp | 18 +++++++++++---
 libs/ui/NanquimWheel.h      | 49 ++++++++++++++++++++++++++++++++++---
 2 files changed, 61 insertions(+), 6 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index dbc1dc3b2c..ff08d08ee2 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -2484,6 +2484,9 @@ QImage brushThumb(const KisPaintOpPresetSP &preset)
                   .scaled(128, 128, Qt::IgnoreAspectRatio, Qt::SmoothTransformation)
                   .convertToFormat(QImage::Format_ARGB32_Premultiplied);
     }
+    // teto: ~96 miniaturas de 128 px (~3 MB); com pacotes grandes, a memória
+    // não cresce sem limite (e o primeiro a entrar é o primeiro a sair)
+    if (s_cache.size() >= 96) s_cache.clear();
     s_cache.insert(id, img);
     return img;
 }
@@ -3572,7 +3575,10 @@ protected:
                 && e->type() != QEvent::TouchBegin) {
             return false;
         }
-        QFrame *flyout = m_mw->findChild<QFrame*>(FLYOUT_ID);
+        if (!m_mw) return false;
+        // caminho do toque: ponteiros guardados, sem procurar na árvore toda
+        if (!m_flyout) m_flyout = m_mw->findChild<QFrame*>(FLYOUT_ID);
+        QFrame *flyout = m_flyout;
         if (!flyout || !flyout->isVisible()) return false;
         QPoint global;
         if (e->type() == QEvent::MouseButtonPress) {
@@ -3585,7 +3591,8 @@ protected:
             global = points.first().screenPos().toPoint();
         }
         const QRect flyRect(flyout->mapToGlobal(QPoint(0, 0)), flyout->size());
-        QToolButton *toggle = m_mw->findChild<QToolButton*>(QStringLiteral("nanquimAllToolsButton"));
+        if (!m_toggle) m_toggle = m_mw->findChild<QToolButton*>(QStringLiteral("nanquimAllToolsButton"));
+        QToolButton *toggle = m_toggle;
         const QRect toggleRect = toggle ? QRect(toggle->mapToGlobal(QPoint(0, 0)), toggle->size()) : QRect();
         if (!flyRect.contains(global) && !toggleRect.contains(global)) {
             setFlyoutVisible(m_mw, false);
@@ -3593,7 +3600,9 @@ protected:
         return false;
     }
 private:
-    KisMainWindow *m_mw;
+    QPointer<KisMainWindow> m_mw;
+    QPointer<QFrame> m_flyout;
+    QPointer<QToolButton> m_toggle;
 };
 
 void buildToolsFlyout(KisMainWindow *mw)
@@ -5158,6 +5167,8 @@ public:
     // entrada da tela inicial: aparece subindo, um cartão depois do outro
     void reveal(int delayMs)
     {
+        if (m_revealed) return;   // entrar na home de novo não repete a animação
+        m_revealed = true;
         m_reveal = 0.0;
         update();
         QPointer<RecentCard> guard(this);
@@ -5234,6 +5245,7 @@ private:
     QIcon m_icon;
     qreal m_reveal = 1.0;
     qreal m_press = 0.0;
+    bool m_revealed = false;
     QPointer<QVariantAnimation> m_pressAnim;
 };
 
diff --git a/libs/ui/NanquimWheel.h b/libs/ui/NanquimWheel.h
index 8015a065fc..17ca59168d 100644
--- a/libs/ui/NanquimWheel.h
+++ b/libs/ui/NanquimWheel.h
@@ -16,6 +16,8 @@
 #include <QImage>
 #include <QStringList>
 #include <QVector>
+#include <QTimer>
+#include <QPointer>
 #include <QtMath>
 #include <functional>
 
@@ -84,6 +86,7 @@ public:
         m_sat = s;
         m_val = v;
         m_triangle = QImage();
+        m_triangleDirty = false;
         update();
     }
 
@@ -166,13 +169,27 @@ protected:
 
     void emitColor()
     {
-        update();
+        // durante o arrasto, só o triângulo e a etiqueta do topo mudam; o anel
+        // de pincéis e a sombra não precisam ser repintados a cada frame
+        update(colorRect());
         if (onColor) onColor(color());
     }
 
+    // área que muda quando a cor muda: anel de matiz com o marcador dele,
+    // triângulo com o marcador de S/B e a etiqueta do topo
+    QRect colorRect() const
+    {
+        const QPointF c = center();
+        const int r = R_HUE_OUT + 16;   // alcança o marcador do anel
+        return QRect(qRound(c.x() - r), qRound(c.y() - r), 2 * r, 2 * r)
+                .united(QRect(0, 0, width(), LABEL_H));
+    }
+
     QImage renderTriangle() const
     {
-        const qreal dpr = devicePixelRatioF();
+        // acima de 2× o olho não vê diferença num gradiente; e o custo do
+        // laço cresce com o quadrado do DPR
+        const qreal dpr = qMin(devicePixelRatioF(), 2.0);
         const QPointF c = center();
         const QRectF box(c.x() - R_TRI, c.y() - R_TRI, 2 * R_TRI, 2 * R_TRI);
         QImage img(QSize(qCeil(box.width() * dpr), qCeil(box.height() * dpr)), QImage::Format_ARGB32_Premultiplied);
@@ -463,6 +480,10 @@ protected:
         m_layerPressed = false;
         m_pressedSector = -1;
         m_zone = None;
+        if (m_triangleDirty) {   // fim do arrasto: o último frame sai em crisp
+            m_triangle = QImage();
+            m_triangleDirty = false;
+        }
         update();
     }
 
@@ -480,13 +501,33 @@ protected:
     {
         if (m_zone == Hue) {
             m_hue = angleToHue(angleOf(p - center()));
-            m_triangle = QImage();
+            // renderizar o triângulo de novo custa um laço por pixel: em vez de
+            // fazê-lo a cada move do arrasto (120 Hz), agrupa e faz a ~33 Hz.
+            // A cor de verdade (etiqueta, swatch, pincel) continua em tempo real.
+            m_triangleDirty = true;
+            scheduleTriangleRender();
             emitColor();
         } else if (m_zone == Tri) {
             pickSV(p);
         }
     }
 
+    void scheduleTriangleRender()
+    {
+        if (m_renderScheduled) return;
+        m_renderScheduled = true;
+        QPointer<NanquimWheel> guard(this);
+        QTimer::singleShot(30, this, [guard]() {
+            if (!guard) return;
+            guard->m_renderScheduled = false;
+            if (guard->m_triangleDirty) {
+                guard->m_triangle = QImage();
+                guard->m_triangleDirty = false;
+                guard->update(guard->colorRect());
+            }
+        });
+    }
+
 private:
     QVector<Brush> m_brushes;
     QString m_layer;
@@ -498,6 +539,8 @@ private:
     qreal m_val = 0.9;
     Zone m_zone = None;
     mutable QImage m_triangle;
+    bool m_triangleDirty = false;
+    bool m_renderScheduled = false;
 };
 
 #endif
