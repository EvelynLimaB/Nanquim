From 4a8f91e02b11c48d9e77a0123456789abcdef070 Mon Sep 17 00:00:00 2001
From: Nanquim <nanquim@users.noreply.github.com>
Date: Tue, 17 Nov 2026 22:15:00 -0300
Subject: [PATCH] Nanquim: texturas de 512 px, teto de 90 FPS e caminho rapido
 da S Pen no canvas

- GPU Android: blocos de textura sobem de 256 para 512 px (4x menos uploads
  em paginas A4/B5) e fpsLimit padrao de 90 Hz para evitar throttling termico
- PenHover: ignora qApp->widgetAt() quando a S Pen esta dentro da margem
  central do canvas e nenhuma janela/pop-up esta aberta
- ColorUseCounter: verifica a geometria do centralWidget em vez de varrer a
  arvore com widgetAt() a cada TabletPress
---
 libs/ui/NanquimTabletUi.cpp | 24 ++++++++++++++++++++----
 libs/ui/kis_config.cc       | 20 ++++++++++++++++++--
 2 files changed, 38 insertions(+), 6 deletions(-)

diff --git a/libs/ui/kis_config.cc b/libs/ui/kis_config.cc
index db19491..89f2c34 100644
--- a/libs/ui/kis_config.cc
+++ b/libs/ui/kis_config.cc
@@ -1125,7 +1125,15 @@ void KisConfig::setUseOpenGLTextureBuffer(bool useBuffer)
 
 int KisConfig::textureSize(bool defaultValue) const
 {
-    return (defaultValue ? 256 : m_cfg.readEntry("textureSize", 256));
+#ifdef Q_OS_ANDROID
+    // Nanquim: blocos de 512 px dividem por 4 as chamadas de upload na GPU
+    // ao movimentar ou pintar em paginas de quadrinhos de alta resolucao.
+    const int fallback = 512;
+#else
+    const int fallback = 256;
+#endif
+    return (defaultValue ? fallback : m_cfg.readEntry("textureSize", fallback));
 }
 
 void KisConfig::setTextureSize(int size)
@@ -2081,7 +2089,15 @@ void KisConfig::setLevelOfDetailThreshold(qreal value)
 
 int KisConfig::fpsLimit(bool defaultValue) const
 {
-    return defaultValue ? 100 : m_cfg.readEntry("fpsLimit", 100);
+#ifdef Q_OS_ANDROID
+    // Nanquim: alinha o limite de quadros do canvas com a tela de 90 Hz do
+    // Galaxy Tab S10 Lite, poupando bateria e evitando aquecimento na GPU.
+    const int fallback = 90;
+#else
+    const int fallback = 100;
+#endif
+    return defaultValue ? fallback : m_cfg.readEntry("fpsLimit", fallback);
 }
 
 void KisConfig::setFpsLimit(int value)
diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index ff08d08ee2..a71c92e410 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -1325,6 +1325,18 @@ private:
     void track(const QPoint &global)
     {
         if (!m_mw) return;
+        // Caminho rapido: se a S Pen esta no miolo da folha de desenho e nao ha
+        // pop-ups abertos, evita chamar qApp->widgetAt() a 240 Hz.
+        if (QWidget *central = m_mw->centralWidget()) {
+            if (central->isVisible() && m_mw->activeView()) {
+                const QRect safeCanvas = QRect(central->mapToGlobal(QPoint(0, 0)), central->size())
+                                             .adjusted(96, 64, -96, -96);
+                if (safeCanvas.contains(global) && !s_popupAnchor && !m_button && !m_list) {
+                    return;
+                }
+            }
+        }
         QAbstractButton *b = hoverTarget(global);
         if (b != m_button) setButton(b);
         else if (m_halo) m_halo->follow(b);   // pop-ups que ainda estão animando
@@ -4182,10 +4194,14 @@ protected:
 private:
     bool onCanvas(const QPoint &global) const
     {
+        if (!m_mw) return false;
         QWidget *central = m_mw->centralWidget();
-        QWidget *w = qApp->widgetAt(global);
-        if (!central || !w || !central->isAncestorOf(w)) return false;
-        return QString::fromLatin1(w->metaObject()->className()).contains(QLatin1String("Canvas"));
+        if (!central || !central->isVisible() || !m_mw->activeView()) return false;
+        const QRect canvasRect(central->mapToGlobal(QPoint(0, 0)), central->size());
+        if (!canvasRect.contains(global)) return false;
+        if (canvasRect.adjusted(110, 60, -110, -110).contains(global)) return true;
+        QWidget *w = qApp->widgetAt(global);
+        return w && central->isAncestorOf(w)
+               && QString::fromLatin1(w->metaObject()->className()).contains(QLatin1String("Canvas"));
     }
     QPointer<KisMainWindow> m_mw;
     bool m_onCanvas = false;
-- 
2.43.0
