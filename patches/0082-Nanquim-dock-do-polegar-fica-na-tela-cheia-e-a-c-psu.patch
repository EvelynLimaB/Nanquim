From e123b20b277141553796fedf0350bc9122e2eeb2 Mon Sep 17 00:00:00 2001
From: Nanquim <nanquim@users.noreply.github.com>
Date: Wed, 18 Nov 2026 10:20:57 -0300
Subject: [PATCH] =?UTF-8?q?Nanquim:=20dock=20do=20polegar=20fica=20na=20te?=
 =?UTF-8?q?la=20cheia=20e=20a=20c=C3=A1psula=20ganha=20o=20bot=C3=A3o=20de?=
 =?UTF-8?q?=20pinc=C3=A9is?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Na tela cheia do Krita o dock do polegar (navegar, refazer, desfazer) não some
  mais: só a cápsula vertical entra e sai deslizando, com mola
- As 3 cores ficam sempre acima do dock; a cápsula, acima das cores
- Novo botão "Pincéis" na cápsula abre a janela de pincéis (o botão do topo
  fica escondido na tela cheia); tocar de novo fecha
---
 libs/ui/NanquimTabletUi.cpp | 63 ++++++++++++++++++++++++-------------
 1 file changed, 41 insertions(+), 22 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index c8a3111..0ab5d24 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -4703,9 +4703,8 @@ void placeThumbDock(KisMainWindow *mw)
     swatch->raise();
     if (QFrame *quick = mw->findChild<QFrame*>(QUICK_COLORS_ID)) {
         quick->adjustSize();
-        // tela cheia: sem o dock, as 3 cores descem para logo acima da bolinha
-        const bool noDock = canvasOnlyActive(mw);
-        const int qy = noDock ? swatchY - 12 - quick->height() : dock->y() - 12 - quick->height();
+        // o dock fica também na tela cheia: as 3 cores ficam sempre acima dele
+        const int qy = dock->y() - 12 - quick->height();
         quick->move(x + (dock->width() - quick->width()) / 2, qMax(area.top() + margin, qy));
         quick->raise();
     }
@@ -4745,10 +4744,11 @@ void setThumbDockVisible(KisMainWindow *mw, bool visible)
     const bool full = visible && canvasOnlyActive(mw);
     const QVariant prevFull = mw->property("nanquimDockFull");
     QFrame *bar = mw->findChild<QFrame*>(QStringLiteral("nanquimFocusBar"));
-    QWidget *outW = full ? static_cast<QWidget*>(dock) : static_cast<QWidget*>(bar);
-    QWidget *inW = full ? static_cast<QWidget*>(bar) : static_cast<QWidget*>(dock);
-    bool animate = visible && prevFull.isValid() && prevFull.toBool() != full
-            && outW && inW && outW->isVisible()
+    // o dock do polegar fica na tela cheia; só a cápsula entra e sai, deslizando
+    QWidget *outW = full ? nullptr : static_cast<QWidget*>(bar);
+    QWidget *inW = full ? static_cast<QWidget*>(bar) : nullptr;
+    bool animate = visible && prevFull.isValid() && prevFull.toBool() != full && bar
+            && (full || bar->isVisible())
             && mw->centralWidget() && mw->centralWidget()->isVisible();
     QRect outGeom;
     QPixmap outShot;
@@ -4759,11 +4759,13 @@ void setThumbDockVisible(KisMainWindow *mw, bool visible)
             s_focusSwapPending->show();
             s_focusSwapPending.clear();
         }
-        outGeom = QRect(outW->mapTo(mw, QPoint(0, 0)), outW->size());
-        outShot = lightShot(outW->grab());
-        animate = !outShot.isNull() && !outGeom.isEmpty();
+        if (outW) {
+            outGeom = QRect(outW->mapTo(mw, QPoint(0, 0)), outW->size());
+            outShot = lightShot(outW->grab());
+            animate = !outShot.isNull() && !outGeom.isEmpty();
+        }
     }
-    dock->setVisible(visible && !full);
+    dock->setVisible(visible);
     swatch->setVisible(visible);
     // tela cheia do Krita: a cápsula vertical (pincel, borracha, lata, transformar,
     // tamanho) entra no lugar do dock, acima das 3 cores
@@ -4792,18 +4794,22 @@ void setThumbDockVisible(KisMainWindow *mw, bool visible)
         return;
     }
     flushLayouts();
-    inW->ensurePolished();
-    const QRect inGeom(inW->mapTo(mw, QPoint(0, 0)), inW->size());
-    const QPixmap inShot = lightShot(inW->grab());
-    if (inShot.isNull() || inGeom.isEmpty()) {
-        return;   // sem foto: tudo já fica no lugar, como era antes
-    }
-    inW->hide();
-    s_focusSwapPending = inW;
-    s_focusSwapToFull = full;
+    QRect inGeom;
+    QPixmap inShot;
+    if (inW) {
+        inW->ensurePolished();
+        inGeom = QRect(inW->mapTo(mw, QPoint(0, 0)), inW->size());
+        inShot = lightShot(inW->grab());
+        if (inShot.isNull() || inGeom.isEmpty()) {
+            return;   // sem foto: tudo já fica no lugar, como era antes
+        }
+        inW->hide();
+        s_focusSwapPending = inW;
+        s_focusSwapToFull = full;
+    }
     const int dir = railOnRight() ? +1 : -1;
-    const int distOut = outGeom.width() + 24;
-    const int distIn = inGeom.width() + 24;
+    const int distOut = outW ? outGeom.width() + 24 : 0;
+    const int distIn = inW ? inGeom.width() + 24 : 0;
     QRect reach = outGeom.united(inGeom);
     if (dir < 0) reach.setLeft(reach.left() - distOut - distIn);
     else reach.setRight(reach.right() + distOut + distIn);
@@ -5082,6 +5088,19 @@ void buildFocusWidgets(KisMainWindow *mw)
 
     // build 60.5: tamanho do pincel no modo foco. O botão abre uma coluna que
     // sobe da cápsula com mola leve; qualquer toque fora (inclusive desenhar) recolhe.
+    // janela de pincéis também na tela cheia (o botão do topo fica escondido)
+    QToolButton *brushesBtn = iconButton(bar, i18n("Pincéis"), designIcon(Svg::PEN, 24), false);
+    brushesBtn->setObjectName(QStringLiteral("nanquimFocusBrushesButton"));
+    brushesBtn->setIconSize(QSize(24, 24));
+    QObject::connect(brushesBtn, &QToolButton::clicked, mw, [mw, brushesBtn]() {
+        QFrame *panel = mw->findChild<QFrame*>(BRUSH_PANEL_ID);
+        const bool wasOpen = panel && panel->isVisible();
+        setBrushPanelVisible(mw, !wasOpen);
+        // o botão que abriu fecha sozinho (o PanelCloser não fecha antes e reabre)
+        if (!wasOpen) s_popupAnchor = brushesBtn;
+    });
+    l->addWidget(brushesBtn);
+
     static const char *SVG_SIZE = "<circle cx='12' cy='12' r='3'/><circle cx='12' cy='12' r='8'/>";
     QToolButton *sizeBtn = iconButton(bar, i18n("Tamanho do pincel"), designIcon(SVG_SIZE, 24), true);
     sizeBtn->setObjectName(QStringLiteral("nanquimFocusSizeButton"));
-- 
