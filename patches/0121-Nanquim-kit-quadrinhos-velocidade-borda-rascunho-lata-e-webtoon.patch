+    thickHead->addWidget(nqLabel(i18n("Espessura"), "nqSmall", d));
+    thickHead->addStretch(1);
+    QLabel *thickVal = nqLabel(QStringLiteral("4 px"), "nqItem", d);
+    thickHead->addWidget(thickVal);
+    controls->addLayout(thickHead);
