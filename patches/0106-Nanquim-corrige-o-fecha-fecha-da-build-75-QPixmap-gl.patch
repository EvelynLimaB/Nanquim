From ff0a21d49e5e8a3b37477b9c95cf5a9e1ecc9bab Mon Sep 17 00:00:00 2001
From: N <n@x>
Date: Thu, 19 Nov 2026 15:21:46 -0300
Subject: [PATCH] Nanquim: corrige o fecha-fecha da build 75, QPixmap global
 criado antes do aplicativo
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

O patch 0105 deixou "QPixmap s_openShot;" no escopo do arquivo. No Qt 5,
criar um QPixmap antes do QGuiApplication aborta o processo, e uma
variável global é criada quando a biblioteca é carregada. Por isso o
app fechava logo depois da tela de abertura do Android, em todo
início, antes de qualquer tela do Nanquim aparecer.

Agora o QPixmap é criado no primeiro uso, já com o aplicativo de pé, e
fica vivo até o fim do processo.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fwRUW9SkxqcJFLYxLRXTf
---
 libs/ui/NanquimTabletUi.cpp | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index 96b1a36..b0529b7 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -6504,16 +6504,18 @@ QString s_pendingChapter;   // capítulo aberto na galeria quando a página nova
 // De onde a página sai ao abrir (a miniatura tocada, em coordenadas da janela)
 // e a foto dela. Quem abre preenche logo antes de chamar openPageWithFeedback.
 QRect s_openFrom;
-QPixmap s_openShot;
+// QPixmap não pode existir antes do QGuiApplication (o Qt aborta ao carregar a
+// biblioteca), então ele nasce no primeiro uso e nunca é destruído
+QPixmap &openShot() { static QPixmap *p = new QPixmap; return *p; }
 
 void setOpenOrigin(QWidget *from, const QRect &local, const QPixmap &shot)
 {
     s_openFrom = QRect();
-    s_openShot = QPixmap();
+    openShot() = QPixmap();
     if (!from || shot.isNull() || local.isEmpty()) return;
     QWidget *win = from->window();
     s_openFrom = QRect(from->mapTo(win, local.topLeft()), local.size());
-    s_openShot = shot;
+    openShot() = shot;
 }
 
 class OpeningVeil : public QWidget
@@ -6645,9 +6647,9 @@ void openPageWithFeedback(KisMainWindow *mw, const QString &path)
     QString name = QFileInfo(path).completeBaseName();
     // a página sai da miniatura tocada (se quem chamou disse de onde)
     const QRect from = s_openFrom;
-    const QPixmap shot = s_openShot;
+    const QPixmap shot = openShot();
     s_openFrom = QRect();
-    s_openShot = QPixmap();
+    openShot() = QPixmap();
     OpeningVeil *veil = new OpeningVeil(mw, i18n("Abrindo %1…", name), detail, from, shot);
     veil->setGeometry(mw->rect());
     veil->show();
