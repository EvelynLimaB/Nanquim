+bool tagPresetAsNanquim(const KoResourceSP &resource)
+{
+    if (!resource || resource->resourceId() < 0) return false;
+    KisTagModel tagModel(ResourceType::PaintOpPresets);
+    KisTagSP tag = tagModel.tagForUrl(QStringLiteral("Nanquim"));
+    if (!tag) return false;
+    KisTagResourceModel tagResourceModel(ResourceType::PaintOpPresets);
+    return tagResourceModel.tagResources(tag, QVector<int>() << resource->resourceId());
+}
