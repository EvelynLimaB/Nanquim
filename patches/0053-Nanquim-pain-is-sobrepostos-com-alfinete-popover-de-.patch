+// Painel solto fecha sozinho: toque rápido do dedo na página, ou 300 ms depois
+// que a caneta levanta (desenhou com ele aberto, ele sai do caminho)
+class PanelCloser : public QObject
+{
+public:
+    explicit PanelCloser(KisMainWindow *mw) : QObject(mw), m_mw(mw)
+    {
+        m_timer.setSingleShot(true);
+        m_timer.setInterval(300);
+        QObject::connect(&m_timer, &QTimer::timeout, this, [this]() {
+            if (!m_mw || m_down) return;
+            QFrame *host = m_mw->findChild<QFrame*>(PANEL_HOST_ID);
+            QDockWidget *dw = hostedDock(m_mw);
+            if (host && host->isVisible() && dw) closePanel(m_mw, dw, true);
+        });
+    }
+protected:
+    bool eventFilter(QObject *, QEvent *e) override
+    {
+        const QEvent::Type t = e->type();
+        if (t != QEvent::TabletPress && t != QEvent::TabletRelease && t != QEvent::TouchBegin
+                && t != QEvent::TouchEnd && t != QEvent::MouseButtonPress) {
+            return false;
+        }
+        if (!m_mw) return false;
+        QFrame *host = m_mw->findChild<QFrame*>(PANEL_HOST_ID);
+        if (!host || !host->isVisible()) {
+            m_armed = false;
+            return false;
+        }
+        if (t == QEvent::TabletPress) {
+            m_down = true;
+            m_armed = onPage(static_cast<QTabletEvent*>(e)->globalPos(), host);
+            m_timer.stop();
+        } else if (t == QEvent::TabletRelease) {
+            m_down = false;
+            if (m_armed) m_timer.start();
+            m_armed = false;
+        } else if (t == QEvent::TouchBegin) {
+            const auto points = static_cast<QTouchEvent*>(e)->touchPoints();
+            if (points.size() == 1) {
+                m_touchStart = points.first().screenPos();
+                m_touchTime.start();
+                m_touchArmed = onPage(m_touchStart.toPoint(), host);
+            } else {
+                m_touchArmed = false;
+            }
+        } else if (t == QEvent::TouchEnd) {
+            const auto points = static_cast<QTouchEvent*>(e)->touchPoints();
+            const bool tap = m_touchArmed && points.size() == 1 && m_touchTime.isValid() && m_touchTime.elapsed() < 350
+                    && QLineF(points.first().screenPos(), m_touchStart).length() < 24;
+            m_touchArmed = false;
+            if (tap) m_timer.start(0);
+        }
+        return false;
+    }
+private:
+    bool onPage(const QPoint &global, QFrame *host) const
+    {
+        QWidget *central = m_mw->centralWidget();
+        if (!central) return false;
+        const QRect page(central->mapToGlobal(QPoint(0, 0)), central->size());
+        const QRect panel(host->mapToGlobal(QPoint(0, 0)), host->size());
+        if (!page.contains(global) || panel.contains(global)) return false;
+        for (const char *id : {"nanquimThumbDock", "nanquimSwatch", "nanquimExpandTab", "nanquimToolsFlyout"}) {
+            if (QWidget *w = m_mw->findChild<QWidget*>(QLatin1String(id))) {
+                if (w->isVisible() && QRect(w->mapToGlobal(QPoint(0, 0)), w->size()).contains(global)) return false;
+            }
+        }
+        return true;
+    }
+    QPointer<KisMainWindow> m_mw;
+    QTimer m_timer;
+    bool m_down = false;
+    bool m_armed = false;
+    bool m_touchArmed = false;
+    QPointF m_touchStart;
+    QElapsedTimer m_touchTime;
+};
