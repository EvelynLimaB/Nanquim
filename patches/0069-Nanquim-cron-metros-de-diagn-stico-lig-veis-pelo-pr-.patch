From: Nanquim <nanquim@users.noreply.github.com>
Date: Tue, 17 Nov 2026 21:46:16 +0000
Subject: [PATCH 4/4] =?UTF-8?q?Nanquim:=20cron=C3=B4metros=20de=20diagn?=
 =?UTF-8?q?=C3=B3stico=20lig=C3=A1veis=20pelo=20pr=C3=B3prio=20app?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Configurações › Desempenho ganha o interruptor "Registrar tempos no log":
  liga a medição da fase de otimização (abertura do app, trocas de tela,
  montagem da janela) sem recompilar nada. O valor vive em Nanquim/tempos
  do kritarc e a leitura acontece uma vez por processo
- NanquimStepTimer obedece ao interruptor (e continua valendo com
  -DNANQUIM_TIMING para builds de medição)
---
 libs/global/NanquimStepTimer.h | 28 +++++++++++++++++++++++-----
 libs/ui/NanquimTabletUi.cpp    | 12 ++++++++++++
 2 files changed, 35 insertions(+), 5 deletions(-)

diff --git a/libs/global/NanquimStepTimer.h b/libs/global/NanquimStepTimer.h
index e466410990..0ae83150ef 100644
--- a/libs/global/NanquimStepTimer.h
+++ b/libs/global/NanquimStepTimer.h
@@ -12,11 +12,19 @@
 
 #include "KisUsageLogger.h"
 
+#ifdef Q_OS_ANDROID
+#include <KSharedConfig>
+#include <KConfigGroup>
+#endif
+
 /**
  * Nanquim: cronômetro de etapas. Cada mark() escreve no log do Krita
  * ("[Nanquim tempo] <prefixo>: <etapa> - N ms") o tempo desde a marca anterior.
- * Só registra no Android e quando o app é compilado com -DNANQUIM_TIMING
- * (diagnóstico de desempenho); fora isso não faz nada.
+ *
+ * Quando registrar: no Android, com -DNANQUIM_TIMING na compilação OU com o
+ * interruptor de diagnóstico ligado no app (Configurações › Desempenho ›
+ * "Registrar tempos no log" — entrada Nanquim/tempos do kritarc). A leitura
+ * da configuração acontece uma vez por processo; fora disso não faz nada.
  */
 class NanquimStepTimer
 {
@@ -30,19 +38,29 @@ public:
     // minMs: só registra etapas que levaram pelo menos isso (evita poluir o log)
     void mark(const QString &step, qint64 minMs = 0)
     {
+#if defined(Q_OS_ANDROID)
         const qint64 ms = m_timer.restart();
-#if defined(Q_OS_ANDROID) && defined(NANQUIM_TIMING)
-        if (ms >= minMs) {
+        if (ms >= minMs && timingOn()) {
             KisUsageLogger::log(QStringLiteral("[Nanquim tempo] %1: %2 - %3 ms").arg(m_prefix, step).arg(ms));
         }
 #else
         Q_UNUSED(step);
         Q_UNUSED(minMs);
-        Q_UNUSED(ms);
+        Q_UNUSED(m_timer.restart());
 #endif
     }
 
 private:
+    static bool timingOn()
+    {
+#ifdef NANQUIM_TIMING
+        return true;
+#else
+        static const bool s_on = KConfigGroup(KSharedConfig::openConfig(), QStringLiteral("Nanquim")).readEntry("tempos", false);
+        return s_on;
+#endif
+    }
+
     QString m_prefix;
     QElapsedTimer m_timer;
 };
diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index b30563274d..b5a9352cd7 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -9495,6 +9495,14 @@ void showSettings(KisMainWindow *mw)
         QCheckBox *lod = new QCheckBox(p);
         lod->setChecked(KisConfig(true).levelOfDetailEnabled());
         l->addWidget(settingRow(p, i18n("Prévia rápida ao dar zoom"), i18n("Desenha numa versão reduzida enquanto o zoom está longe."), lod));
+        l->addWidget(nqDivider(p));
+        // diagnóstico da fase de otimização: marca os tempos de cada tela no
+        // log do Krita (medir antes de mudar). Pode deixar desligado.
+        QCheckBox *timing = new QCheckBox(p);
+        timing->setChecked(KSharedConfig::openConfig()->group(QStringLiteral("Nanquim")).readEntry("tempos", false));
+        l->addWidget(settingRow(p, i18n("Registrar tempos no log (diagnóstico)"),
+                                i18n("Marca quanto leva abrir o app, trocar de tela e montar a janela. "
+                                     "Manda o arquivo de log junto quando for reportar lentidão."), timing));
         l->addStretch(1);
         QObject::connect(mem, &QSlider::valueChanged, d, [memValue](int v) {
             memValue->setText(i18n("%1% da memória do tablet", v));
@@ -9506,6 +9514,10 @@ void showSettings(KisMainWindow *mw)
             cfg.setLevelOfDetailEnabled(on);
             KisConfigNotifier::instance()->notifyConfigChanged();
         });
+        QObject::connect(timing, &QCheckBox::toggled, d, [](bool on) {
+            KSharedConfig::openConfig()->group(QStringLiteral("Nanquim")).writeEntry("tempos", on);
+            KSharedConfig::openConfig()->sync();
+        });
     }
 
     // --- salvamento ----------------------------------------------------------------
