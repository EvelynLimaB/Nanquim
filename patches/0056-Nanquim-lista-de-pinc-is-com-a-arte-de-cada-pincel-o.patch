+// a arte do pincel (a miniatura que vem dentro do preset), a mesma que o Krita
+// mostra no seletor de presets. Guardada já em quadrado e no dobro do tamanho.
+QImage brushThumb(const KisPaintOpPresetSP &preset)
+{
+    static QHash<int, QImage> s_cache;
+    if (!preset) return QImage();
+    const int id = preset->resourceId();
+    const auto it = s_cache.constFind(id);
+    if (it != s_cache.constEnd()) return it.value();
+    QImage img = preset->image();
+    if (!img.isNull()) {
+        const int side = qMin(img.width(), img.height());
+        img = img.copy((img.width() - side) / 2, (img.height() - side) / 2, side, side)
+                  .scaled(128, 128, Qt::IgnoreAspectRatio, Qt::SmoothTransformation)
+                  .convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    }
+    s_cache.insert(id, img);
+    return img;
+}
+
+void paintBrushThumb(QPainter &g, const QRectF &r, const QModelIndex &index)
+{
+    g.save();
+    g.setRenderHint(QPainter::Antialiasing);
+    g.setRenderHint(QPainter::SmoothPixmapTransform);
+    QPainterPath shape;
+    shape.addRoundedRect(r, 9, 9);
+    g.setClipPath(shape);
+    g.fillPath(shape, QColor(0xce, 0xce, 0xce));   // o cinza dos ícones do Krita
+    const QImage img = brushThumb(presetForId(index.data(BrushIdRole).toInt()));
+    if (!img.isNull()) {
+        g.drawImage(r, img);
+    } else {
+        // preset sem arte: a onda desenhada segura o lugar
+        paintStrokeSample(g, r.adjusted(5, 8, -5, -8), StrokeStyle(index.data(BrushStyleRole).toInt()),
+                          qMax<qreal>(0.12, index.data(BrushWeightRole).toReal()), QColor(0x2b, 0x2d, 0x33));
+    }
+    g.restore();
+}
+
+// desenha a imagem preenchendo o retângulo, cortando o que sobra no centro
+void drawImageCover(QPainter &g, const QRectF &r, const QImage &img)
+{
+    if (img.isNull() || r.isEmpty()) return;
+    const qreal scale = qMax(r.width() / img.width(), r.height() / img.height());
+    const qreal w = r.width() / scale;
+    const qreal h = r.height() / scale;
+    g.drawImage(r, img, QRectF((img.width() - w) / 2.0, (img.height() - h) / 2.0, w, h));
+}
+
+// amostra do pincel numa placa de papel: o traço aparece como ficaria na página
+void paintBrushSample(QPainter &g, const QRectF &r, const QModelIndex &index)
+{
+    g.save();
+    g.setRenderHint(QPainter::Antialiasing);
+    g.setRenderHint(QPainter::SmoothPixmapTransform);
+    QPainterPath plate;
+    plate.addRoundedRect(r, 8, 8);
+    g.setClipPath(plate);
+    g.fillPath(plate, QColor(0xfa, 0xfa, 0xf7));
+    const QColor ink(0x1b, 0x1d, 0x22);
+    const StrokeStyle style = StrokeStyle(index.data(BrushStyleRole).toInt());
+    const qreal weight = qMax<qreal>(0.12, index.data(BrushWeightRole).toReal());
+    KisPaintOpPresetSP preset = presetForId(index.data(BrushIdRole).toInt());
+    QImage img;
+    BrushPreviewer *previewer = BrushPreviewer::instance();
+    const BrushPreviewer::State state = previewer ? previewer->request(preset, &img) : BrushPreviewer::Unsupported;
+    if (state == BrushPreviewer::Ready) {
+        drawImageCover(g, r, img);
+    } else if (state == BrushPreviewer::Pending) {
+        // o traço real ainda está sendo feito: a amostra desenhada segura o lugar
+        g.setOpacity(0.28);
+        paintStrokeSample(g, r.adjusted(8, 4, -8, -4), style, weight, ink);
+    } else {
+        paintStrokeSample(g, r.adjusted(8, 4, -8, -4), style, weight, ink);
+    }
+    g.restore();
+}
