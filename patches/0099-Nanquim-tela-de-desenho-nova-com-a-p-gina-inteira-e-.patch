+            menu->clear();
+            menu->addAction(designIcon(Svg::ALL_TOOLS, 18), i18n("Todas as ferramentas"), w, [w]() { setFlyoutVisible(w, true); });
+            if (QAction *text = act(w, "SvgTextTool")) {
