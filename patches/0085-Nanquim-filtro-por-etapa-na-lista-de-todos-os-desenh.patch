From 5b6644dd9ffa68454650900977e515ed70d8a229 Mon Sep 17 00:00:00 2001
From: N <n@x>
Date: Wed, 18 Nov 2026 10:37:10 -0300
Subject: [PATCH 85/85] Nanquim: filtro por etapa na lista de todos os desenhos
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Novos filtros Rascunhos, Arte-final e Prontas ao lado de Todos e Páginas soltas,
  com a bolinha na cor da etiqueta de cada etapa
- Só páginas de capítulo têm etapa; páginas soltas somem quando um filtro de etapa está ativo
---
 libs/ui/NanquimTabletUi.cpp | 32 ++++++++++++++++++++++++++++----
 1 file changed, 28 insertions(+), 4 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index 2e3fb48..be53339 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -6502,17 +6502,24 @@ class RecentsFilter : public QSortFilterProxyModel
 public:
     using QSortFilterProxyModel::QSortFilterProxyModel;
     void setLooseOnly(bool on) { m_looseOnly = on; invalidateFilter(); }
+    // -1: todas as etapas; 0 rascunho, 1 arte-final, 2 pronta (só páginas de capítulo)
+    void setStage(int stage) { m_stage = stage; invalidateFilter(); }
     void refilter() { invalidateFilter(); }
 protected:
     bool filterAcceptsRow(int row, const QModelIndex &parent) const override
     {
         if (!QSortFilterProxyModel::filterAcceptsRow(row, parent)) return false;
-        if (!m_looseOnly) return true;
+        if (!m_looseOnly && m_stage < 0) return true;
         const QString path = sourceModel()->index(row, 0, parent).data(Qt::ToolTipRole).toString();
-        return chapterOf(path).isEmpty();
+        const QString chapter = chapterOf(path);
+        if (m_stage >= 0) {
+            return !chapter.isEmpty() && ChapterStore::instance()->status(chapter, path) == m_stage;
+        }
+        return chapter.isEmpty();
     }
 private:
     bool m_looseOnly = false;
+    int m_stage = -1;
 };
 
 // botão "voltar" do Android (e Esc) fecha o capítulo aberto
@@ -6859,9 +6866,23 @@ QWidget *buildGallery(KisMainWindow *mw)
     hint->hide();
     recentsHead->addWidget(hint);
     QButtonGroup *filterGroup = new QButtonGroup(allPage);
-    const QStringList filters = {i18n("Todos"), i18n("Páginas soltas")};
+    // 0 todos, 1 soltas, 2 a 4: etapa (rascunho, arte-final, pronta), nas cores das etiquetas
+    const QStringList filters = {i18n("Todos"), i18n("Páginas soltas"), i18n("Rascunhos"), i18n("Arte-final"), i18n("Prontas")};
+    const QColor stageDots[] = {QColor(), QColor(), QColor(0xe6, 0xb4, 0x5a), QColor(0x22, 0xd3, 0xee), QColor(0x5e, 0xc9, 0x8c)};
     for (int i = 0; i < filters.size(); i++) {
         QPushButton *chip = new QPushButton(filters[i], allPage);
+        if (stageDots[i].isValid()) {
+            QPixmap dot(12, 12);
+            dot.fill(Qt::transparent);
+            QPainter dp(&dot);
+            dp.setRenderHint(QPainter::Antialiasing);
+            dp.setPen(Qt::NoPen);
+            dp.setBrush(stageDots[i]);
+            dp.drawEllipse(QRectF(1, 1, 10, 10));
+            dp.end();
+            chip->setIcon(QIcon(dot));
+            chip->setIconSize(QSize(12, 12));
+        }
         chip->setProperty("class", QStringLiteral("nanquimChip"));
         chip->setCheckable(true);
         chip->setChecked(i == 0);
@@ -6878,7 +6899,10 @@ QWidget *buildGallery(KisMainWindow *mw)
     proxy->setSourceModel(&KisRecentDocumentsModelWrapper::instance()->model());
     proxy->setFilterCaseSensitivity(Qt::CaseInsensitive);
     QObject::connect(search, &QLineEdit::textChanged, proxy, &QSortFilterProxyModel::setFilterFixedString);
-    QObject::connect(filterGroup, &QButtonGroup::idClicked, proxy, [proxy](int id) { proxy->setLooseOnly(id == 1); });
+    QObject::connect(filterGroup, &QButtonGroup::idClicked, proxy, [proxy](int id) {
+        proxy->setLooseOnly(id == 1);
+        proxy->setStage(id >= 2 ? id - 2 : -1);
+    });
 
     auto makeGrid = [](QWidget *parent) {
         QListView *v = new QListView(parent);
