From 620fc96b8ca9edb9de8f3ddeacabf590294ab57e Mon Sep 17 00:00:00 2001
From: N <n@x>
Date: Wed, 18 Nov 2026 11:16:15 -0300
Subject: [PATCH 89/92] Nanquim: faixa de cor com o tipo de cada camada
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Uma faixa fina na ponta da camada mostra o tipo: azul tinta, azul claro vetor
  e texto, ciano retícula e preenchimento, âmbar rascunho, cinza grupo
- Rascunho e retícula também são reconhecidos pelo nome da camada
---
 plugins/dockers/layerdocker/NodeDelegate.cpp | 43 ++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/plugins/dockers/layerdocker/NodeDelegate.cpp b/plugins/dockers/layerdocker/NodeDelegate.cpp
index 99b0251..3c289a0 100644
--- a/plugins/dockers/layerdocker/NodeDelegate.cpp
+++ b/plugins/dockers/layerdocker/NodeDelegate.cpp
@@ -37,6 +37,36 @@
 typedef KisBaseNode::Property* OptionalProperty;
 
 #include <kis_base_node.h>
+#include "kis_node.h"
+#include "kis_node_filter_proxy_model.h"
+
+namespace {
+// Nanquim: faixa de cor na ponta de cada camada mostra o tipo dela.
+// Azul tinta, azul claro vetor e texto, ciano retícula e preenchimento,
+// âmbar rascunho, cinza grupo (cores de papel fixo do Nanquim).
+QColor nanquimLayerBand(const QModelIndex &index)
+{
+    KisNodeSP node;
+    if (const KisNodeFilterProxyModel *proxy = qobject_cast<const KisNodeFilterProxyModel*>(index.model())) {
+        node = proxy->nodeFromIndex(index);
+    } else if (const KisNodeModel *model = qobject_cast<const KisNodeModel*>(index.model())) {
+        node = model->nodeFromIndex(index);
+    }
+    if (!node) return QColor();
+    const QString name = node->name().toLower();
+    if (name.contains(QStringLiteral("rascunho")) || name.contains(QStringLiteral("sketch"))) {
+        return QColor(0xe6, 0xb4, 0x5a);
+    }
+    if (node->inherits("KisGeneratorLayer") || name.contains(QStringLiteral("retícula"))
+            || name.contains(QStringLiteral("screentone"))) {
+        return QColor(0x22, 0xd3, 0xee);
+    }
+    if (node->inherits("KisGroupLayer")) return QColor(0x6b, 0x71, 0x7c);
+    if (node->inherits("KisShapeLayer")) return QColor(0x6a, 0xa6, 0xff);
+    if (node->inherits("KisPaintLayer")) return QColor(0x3d, 0x8b, 0xff);
+    return QColor();
+}
+}
 
 class NodeDelegate::Private
 {
@@ -133,6 +163,19 @@ void NodeDelegate::paint(QPainter *p, const QStyleOptionViewItem &o, const QMode
         } else {
             p->setFont(option.font);
             drawColorLabel(p, option, index);
+            {
+                const QColor band = nanquimLayerBand(index);
+                if (band.isValid()) {
+                    const int x = option.direction == Qt::RightToLeft ? option.rect.right() - 3 : option.rect.left() + 1;
+                    const QRectF r(x, option.rect.top() + 4, 3, option.rect.height() - 8);
+                    p->save();
+                    p->setRenderHint(QPainter::Antialiasing);
+                    p->setPen(Qt::NoPen);
+                    p->setBrush(band);
+                    p->drawRoundedRect(r, 1.5, 1.5);
+                    p->restore();
+                }
+            }
             drawThumbnail(p, option, index);
             drawText(p, option, index); // BUG: Creating group moves things around (RTL-layout alignment)
             drawIcons(p, option, index);
