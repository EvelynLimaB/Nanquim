- Botão Espelhar página (mirror_canvas) no dock do polegar para conferir
  proporções e simetria da arte com um toque
- Anel ativo das 3 cores rápidas em degradê ciano-azul (#22d3ee -> #3d8bff)
- Avisos (showToast) com relevo em degradê, borda azul viva e entrada elástica
---
 libs/ui/NanquimTabletUi.cpp |  34 ++++++++++++++++++++++++++--------
 1 file changed, 26 insertions(+), 8 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index 570674cc3a..579cb22d83 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -4471,9 +4471,13 @@
     QPainter g(&pm);
     g.setRenderHint(QPainter::Antialiasing);
     if (active) {
-        g.setPen(QPen(QColor(0x3d, 0x8b, 0xff), 3));
+        const QRectF ringRect(1.5, 1.5, size - 3, size - 3);
+        QLinearGradient rg(ringRect.topLeft(), ringRect.bottomRight());
+        rg.setColorAt(0.0, QColor(0x22, 0xd3, 0xee));
+        rg.setColorAt(1.0, QColor(0x3d, 0x8b, 0xff));
+        g.setPen(QPen(QBrush(rg), 3.0));
         g.setBrush(Qt::NoBrush);
-        g.drawEllipse(QRectF(1.5, 1.5, size - 3, size - 3));
+        g.drawEllipse(ringRect);
     }
     g.setPen(QPen(QColor(0x3a, 0x3f, 0x48), 1));
     g.setBrush(c);
@@ -4794,6 +4798,19 @@
     });
     l->addWidget(navigate);
 
+    // Espelhar página: vira a folha na horizontal em um toque para checar proporção e simetria
+    if (QAction *mirrorAct = act(mw, "mirror_canvas")) {
+        static const char *SVG_MIRROR =
+            "<path d='M12 3v18' stroke-dasharray='2.5 2.5'/>"
+            "<path d='M4 17l5-10v10z'/><path d='M20 17l-5-10v10z'/>";
+        QToolButton *mirrorBtn = makeButton(i18n("Espelhar página"), SVG_MIRROR, true);
+        mirrorBtn->setObjectName(QStringLiteral("nanquimMirrorCanvas"));
+        mirrorBtn->setChecked(mirrorAct->isChecked());
+        QObject::connect(mirrorBtn, &QToolButton::clicked, mirrorAct, &QAction::trigger);
+        QObject::connect(mirrorAct, &QAction::toggled, mirrorBtn, &QToolButton::setChecked);
+        l->addWidget(mirrorBtn);
+    }
+
     // Borracha em Modo Mola: toque curto alterna; segurar (>200 ms) ativa
     // enquanto o polegar pressiona e volta ao pincel ao soltar.
     if (QAction *eraseAct = act(mw, "erase_action")) {
@@ -7813,8 +7830,9 @@
     toast->setObjectName(QStringLiteral("nanquimToast"));
     toast->setAttribute(Qt::WA_TransparentForMouseEvents);
     toast->setStyleSheet(QStringLiteral(
-        "QFrame#nanquimToast { background: #15171b; border: 1px solid #2a2e35; border-radius: 24px; }"
-        "QLabel { color: #eceef2; font-size: 14px; font-weight: 500; background: transparent; }"));
+        "QFrame#nanquimToast { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1b1e23, stop:1 #15171b);"
+        "  border: 1px solid #3d8bff; border-radius: 24px; }"
+        "QLabel { color: #eceef2; font-size: 14px; font-weight: 600; background: transparent; }"));
     QHBoxLayout *l = new QHBoxLayout(toast);
     l->setContentsMargins(18, 10, 22, 10);
     l->setSpacing(12);
@@ -7825,14 +7843,14 @@
     toast->adjustSize();
     const int x = (mw->width() - toast->width()) / 2;
     const int yEnd = mw->height() - toast->height() - 28;
-    toast->move(x, yEnd + 30);
+    toast->move(x, yEnd + 34);
     toast->show();
     toast->raise();
     QPropertyAnimation *in = new QPropertyAnimation(toast, "pos", toast);
-    in->setDuration(220);
-    in->setStartValue(QPoint(x, yEnd + 30));
+    in->setDuration(260);
+    in->setStartValue(QPoint(x, yEnd + 34));
     in->setEndValue(QPoint(x, yEnd));
-    in->setEasingCurve(QEasingCurve::OutCubic);
+    in->setEasingCurve(softSpring());
     in->start(QAbstractAnimation::DeleteWhenStopped);
     QPointer<QFrame> guard(toast);
     QTimer::singleShot(2600, toast, [guard, x, yEnd]() {
