+/// Nanquim: registro de recursos que falham ao carregar (presets de bundle
+/// com dependência quebrada). Sem isto, cada inicialização recarrega e falha
+/// de novo em todos eles, gastando tempo de abertura. A chave guarda
+/// url+versão: mudou o arquivo, tenta de novo.
+QString brokenResourceKey(const QString &storageLocation, const QString &url)
+{
+    return QString::fromLatin1(QCryptographicHash::hash(
+            (storageLocation + QLatin1Char('/') + url).toUtf8(),
+            QCryptographicHash::Sha1).toHex());
+}
+
+bool isKnownBrokenResource(const KisResourceStorageSP &storage, const ResourceVersion &item)
+{
+    KConfigGroup cfg(KSharedConfig::openConfig(), QStringLiteral("NanquimBrokenResources"));
+    const QStringList saved = cfg.readEntry(brokenResourceKey(storage->location(), item.url), QStringList());
+    return saved.size() == 2
+            && saved.at(0).toLongLong() == item.timestamp.toSecsSinceEpoch()
+            && saved.at(1).toInt() == item.version;
+}
+
+void markBrokenResource(const KisResourceStorageSP &storage, const ResourceVersion &item)
+{
+    KConfigGroup cfg(KSharedConfig::openConfig(), QStringLiteral("NanquimBrokenResources"));
+    cfg.writeEntry(brokenResourceKey(storage->location(), item.url),
+                   QStringList {QString::number(item.timestamp.toSecsSinceEpoch()),
+                                QString::number(item.version)});
+    // sincroniza depois (agrupado): o Android mata o app sem fechar direito,
+    // e sem sync explícito a lista não sobreviveria à sessão
+    QTimer::singleShot(2000, []() { KSharedConfig::openConfig()->sync(); });
+}
+
+void unmarkBrokenResource(const KisResourceStorageSP &storage, const ResourceVersion &item)
+{
+    KConfigGroup cfg(KSharedConfig::openConfig(), QStringLiteral("NanquimBrokenResources"));
+    cfg.deleteEntry(brokenResourceKey(storage->location(), item.url));
+}
 }
 
