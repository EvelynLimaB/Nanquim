From 976d6ff38da9c56c0dfedb06b95f49338a3406dd Mon Sep 17 00:00:00 2001
From: Nanquim <nanquim@users.noreply.github.com>
Date: Tue, 17 Nov 2026 14:52:52 -0300
Subject: [PATCH] Nanquim: tela cheia do Krita com a capsula vertical

- Botao de modo foco da barra do topo liga a tela cheia do Krita (a mesma do
  gesto de quatro dedos)
- Na tela cheia some o dock (mover, refazer, desfazer); ficam a bolinha de cor,
  as 3 cores e, acima delas, a capsula vertical (pincel, borracha, lata,
  transformar e tamanho)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012fwRUW9SkxqcJFLYxLRXTf
---
 libs/ui/NanquimTabletUi.cpp | 51 +++++++++++++++++++++++++++++++++----
 1 file changed, 46 insertions(+), 5 deletions(-)

diff --git a/libs/ui/NanquimTabletUi.cpp b/libs/ui/NanquimTabletUi.cpp
index 2ce12b0..caad7d3 100644
--- a/libs/ui/NanquimTabletUi.cpp
+++ b/libs/ui/NanquimTabletUi.cpp
@@ -3283,10 +3283,13 @@ void buildTopBar(KisMainWindow *mw)
     // modo foco: esconde as barras (sai pelo botão no canto da página)
     {
         static const char *SVG_FOCUS = "<path d='M4 9V5h4M20 9V5h-4M4 15v4h4M20 15v4h-4'/>";
-        QToolButton *focus = iconButton(top, i18n("Modo foco: esconder barras"), designIcon(SVG_FOCUS));
+        QToolButton *focus = iconButton(top, i18n("Tela cheia (como o gesto de quatro dedos)"), designIcon(SVG_FOCUS));
         focus->setObjectName(QStringLiteral("nanquimFocusButton"));
         focus->setProperty(NEEDS_CANVAS, true);
-        QObject::connect(focus, &QToolButton::clicked, mw, [mw]() { setFocusMode(mw, true); });
+        // build 62.5: usa a tela cheia do próprio Krita em vez do modo foco do Nanquim
+        QObject::connect(focus, &QToolButton::clicked, mw, [mw]() {
+            if (QAction *a = act(mw, "view_show_canvas_only")) a->trigger();
+        });
         top->addWidget(focus);
     }
 
@@ -4193,6 +4196,8 @@ void placeFocusWidgets(KisMainWindow *mw)
     }
 }
 
+bool canvasOnlyActive(KisMainWindow *mw);
+
 void placeThumbDock(KisMainWindow *mw)
 {
     QFrame *dock = mw->findChild<QFrame*>(THUMB_DOCK_ID);
@@ -4214,13 +4219,21 @@ void placeThumbDock(KisMainWindow *mw)
     swatch->raise();
     if (QFrame *quick = mw->findChild<QFrame*>(QUICK_COLORS_ID)) {
         quick->adjustSize();
-        const int qy = dock->y() - 12 - quick->height();
+        // tela cheia: sem o dock, as 3 cores descem para logo acima da bolinha
+        const bool noDock = canvasOnlyActive(mw);
+        const int qy = noDock ? swatchY - 12 - quick->height() : dock->y() - 12 - quick->height();
         quick->move(x + (dock->width() - quick->width()) / 2, qMax(area.top() + margin, qy));
         quick->raise();
     }
     placeFocusWidgets(mw);
 }
 
+bool canvasOnlyActive(KisMainWindow *mw)
+{
+    QAction *a = act(mw, "view_show_canvas_only");
+    return a && a->isChecked();
+}
+
 void setThumbDockVisible(KisMainWindow *mw, bool visible)
 {
     QFrame *dock = mw->findChild<QFrame*>(THUMB_DOCK_ID);
@@ -4232,11 +4245,24 @@ void setThumbDockVisible(KisMainWindow *mw, bool visible)
         flushLayouts();
         placeThumbDock(mw);
     }
-    dock->setVisible(visible);
+    const bool full = visible && canvasOnlyActive(mw);
+    dock->setVisible(visible && !full);
     swatch->setVisible(visible);
+    // tela cheia do Krita: a cápsula vertical (pincel, borracha, lata, transformar,
+    // tamanho) entra no lugar do dock, acima das 3 cores
+    if (QWidget *bar = mw->findChild<QWidget*>(QStringLiteral("nanquimFocusBar"))) bar->setVisible(full);
+    if (!full) {
+        if (QFrame *sizeBox = mw->findChild<QFrame*>(QStringLiteral("nanquimFocusSize"))) {
+            sizeBox->setProperty("nanquimOpen", false);
+            sizeBox->setProperty("nanquimSlide", 0.0);
+            sizeBox->hide();
+        }
+        if (QToolButton *b = mw->findChild<QToolButton*>(QStringLiteral("nanquimFocusSizeButton"))) b->setChecked(false);
+    }
     if (QFrame *quick = mw->findChild<QFrame*>(QUICK_COLORS_ID)) {
         quick->setVisible(visible);
     }
+    if (full) placeThumbDock(mw);   // a cápsula se alinha às 3 cores já visíveis
 }
 
 // mantém o dock no lugar quando a área de desenho muda (painel aberto, rotação, janela dividida)
@@ -9665,7 +9691,22 @@ void NanquimTabletUi::install(KisMainWindow *mw)
         buildToolNav(mw);
         buildToolsFlyout(mw);
         buildThumbDock(mw);
-        buildFocusWidgets(mw);
+        buildFocusWidgets(mw);   // cápsula vertical: aparece só na tela cheia do Krita
+        // build 62.5: na tela cheia do Krita, some só o dock (mover, refazer, desfazer);
+        // a bolinha de cor e as 3 cores ficam
+        if (QAction *canvasOnly = act(mw, "view_show_canvas_only")) {
+            QPointer<KisMainWindow> guard(mw);
+            QObject::connect(canvasOnly, &QAction::toggled, mw, [guard](bool) {
+                for (int ms : {0, 120, 400}) {   // o Krita reorganiza a janela em etapas
+                    QTimer::singleShot(ms, guard, [guard]() {
+                        if (!guard) return;
+                        // só na tela de desenho (a bolinha de cor visível); a tela inicial fica como está
+                        QWidget *swatch = guard->findChild<QWidget*>(SWATCH_ID);
+                        if (swatch && swatch->isVisible()) setThumbDockVisible(guard, true);
+                    });
+                }
+            });
+        }
         installPanelBehavior(mw);
         installStabilizerPerBrush(mw);
         qApp->installEventFilter(new WheelCloser(mw));
-- 
2.43.0

