+
+    // --- camadas -------------------------------------------------------------
+    QFrame *layers = studioPiece(mw, STUDIO_LAYERS_ID);
+    {
+        QVBoxLayout *l = new QVBoxLayout(layers);
+        l->setContentsMargins(12, 14, 12, 12);
