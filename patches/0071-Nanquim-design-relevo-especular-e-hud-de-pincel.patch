+// ---------------------------------------------------------------------------
+// HUD Fantasma de Calibre e Opacidade (exibe o diametro real no zoom atual)
+// ---------------------------------------------------------------------------
+class NanquimBrushHud : public QWidget
+{
+public:
+    explicit NanquimBrushHud(KisMainWindow *mw) : QWidget(mw), m_mw(mw)
+    {
+        setObjectName(QStringLiteral("nanquimBrushHud"));
+        setAttribute(Qt::WA_TranslucentBackground, true);
+        setAttribute(Qt::WA_TransparentForMouseEvents, true);
+        setFocusPolicy(Qt::NoFocus);
+        m_hideTimer.setSingleShot(true);
+        m_hideTimer.setInterval(520);
+        QObject::connect(&m_hideTimer, &QTimer::timeout, this, &QWidget::hide);
+        hide();
+    }
+
+    void flash(qreal brushPx, qreal opacityNorm)
+    {
+        if (!m_mw || !m_mw->centralWidget()) return;
+        QWidget *central = m_mw->centralWidget();
+        setGeometry(QRect(central->mapTo(m_mw, QPoint(0, 0)), central->size()));
+
+        qreal zoom = 1.0;
+        if (m_mw->viewManager() && m_mw->viewManager()->canvasBase()
+                && m_mw->viewManager()->canvasBase()->coordinatesConverter()) {
+            zoom = m_mw->viewManager()->canvasBase()->coordinatesConverter()->effectiveZoom();
+        }
+        m_rawPx = qBound(1.0, brushPx, 1000.0);
+        m_screenDiameter = qBound(6.0, m_rawPx * zoom, qMin(width(), height()) * 0.75);
+        m_opacity = qBound(0.01, opacityNorm, 1.0);
+
+        raise();
+        show();
+        update();
+        m_hideTimer.start();
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        const QPointF center(width() * 0.5, height() * 0.5);
+        const qreal radius = m_screenDiameter * 0.5;
+
+        p.setBrush(QColor(61, 139, 255, qRound(m_opacity * 68)));
+        p.setPen(QPen(QColor(34, 211, 238, 230), 1.8));
+        p.drawEllipse(center, radius, radius);
+
+        p.setPen(QPen(QColor(236, 238, 242, 150), 1.0));
+        p.drawLine(center - QPointF(4, 0), center + QPointF(4, 0));
+        p.drawLine(center - QPointF(0, 4), center + QPointF(0, 4));
+
+        const QString label = QStringLiteral("%1 px  •  %2%")
+                                  .arg(qRound(m_rawPx))
+                                  .arg(qRound(m_opacity * 100.0));
+        QFont f = font();
+        f.setPixelSize(12);
+        f.setWeight(QFont::DemiBold);
+        p.setFont(f);
+        const QRect fm = p.fontMetrics().boundingRect(label);
+        QRectF pill(0, 0, fm.width() + 24, 28);
+        pill.moveCenter(QPointF(center.x(), qMax(24.0, center.y() - radius - 22.0)));
+
+        p.setBrush(QColor(21, 23, 27, 235));
+        p.setPen(QPen(QColor(61, 139, 255, 140), 1.0));
+        p.drawRoundedRect(pill, 14, 14);
+        p.setPen(QColor(236, 238, 242));
+        p.drawText(pill, Qt::AlignCenter, label);
+    }
+
+private:
+    QPointer<KisMainWindow> m_mw;
+    QTimer m_hideTimer;
+    qreal m_rawPx = 10.0;
+    qreal m_screenDiameter = 20.0;
+    qreal m_opacity = 1.0;
+};
+
+void showBrushHud(KisMainWindow *mw)
+{
+    if (!mw || !mw->viewManager() || !mw->viewManager()->canvasResourceProvider()) return;
+    NanquimBrushHud *hud = mw->findChild<NanquimBrushHud*>(QStringLiteral("nanquimBrushHud"));
+    if (!hud) hud = new NanquimBrushHud(mw);
+    auto *prov = mw->viewManager()->canvasResourceProvider();
+    hud->flash(prov->size(), prov->opacity());
+}
