+            if (QDockWidget *options = findDock(w, {QStringLiteral("sharedtooldocker")})) {
+                menu->addAction(designIcon(Svg::OPTIONS, 18), i18n("Opções da ferramenta"), w, [w, options, more]() {
+                    togglePanelFrom(w, options, more);
