@@ -10454,7 +10530,11 @@ void NanquimTabletUi::install(KisMainWindow *mw)
         // a bolinha de cor e as 3 cores ficam
         if (QAction *canvasOnly = act(mw, "view_show_canvas_only")) {
             QPointer<KisMainWindow> guard(mw);
-            QObject::connect(canvasOnly, &QAction::toggled, mw, [guard](bool) {
+            QObject::connect(canvasOnly, &QAction::toggled, mw, [guard](bool on) {
+                {
+                    QWidget *sw = guard ? guard->findChild<QWidget*>(SWATCH_ID) : nullptr;
+                    if (sw && sw->isVisible()) animateChrome(guard, on);
+                }
                 for (int ms : {0, 120, 400}) {   // o Krita reorganiza a janela em etapas
                     QTimer::singleShot(ms, guard, [guard]() {
                         if (!guard) return;
