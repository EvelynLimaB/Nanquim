+// ---------------------------------------------------------------------------
+// Modo foco: some a barra do topo, a barra lateral e o dock do polegar. Fica
+// a página, uma cápsula com Pincel, Borracha e Lata de tinta e o botão de
+// sair no canto. Dois dedos desfazem e três refazem (gestos do Krita).
+// ---------------------------------------------------------------------------
+void buildFocusWidgets(KisMainWindow *mw)
+{
+    QFrame *bar = new QFrame(mw);
+    bar->setObjectName(QStringLiteral("nanquimFocusBar"));
+    bar->setStyleSheet(QStringLiteral(
+        "QFrame#nanquimFocusBar { background: rgba(34,38,44,0.92); border: 1px solid #33373f; border-radius: 30px; }"
+        "QFrame#nanquimFocusBar QToolButton { border: none; border-radius: 12px; padding: 0;"
+        "  min-width: 48px; max-width: 48px; min-height: 48px; max-height: 48px; }"
+        "QFrame#nanquimFocusBar QToolButton:pressed { background: #2a2e35; }"
+        "QFrame#nanquimFocusBar QToolButton:checked { background: #16294a; }"
+        "QFrame#nanquimFocusBar QToolButton[nanquimHover=\"true\"]:!checked { background: rgba(255,255,255,0.08); }"));
+    QHBoxLayout *l = new QHBoxLayout(bar);
+    l->setContentsMargins(8, 4, 8, 4);
+    l->setSpacing(2);
+    QAction *erase = act(mw, "erase_action");
+    struct Entry { const char *tip; const char *svg; const char *id; bool eraser; };
+    const Entry entries[] = {{"Pincel", Svg::BRUSH, "KritaShape/KisToolBrush", false},
+                             {"Borracha", Svg::ERASER, "KritaShape/KisToolBrush", true},
+                             {"Lata de tinta", Svg::BUCKET, "KritaFill/KisToolFill", false}};
+    QList<QPair<QToolButton*, Entry>> buttons;
+    for (const Entry &en : entries) {
+        QAction *tool = act(mw, en.id);
+        if (!tool || (en.eraser && !erase)) continue;
+        QToolButton *b = iconButton(bar, i18n(en.tip), designIcon(en.svg, 24), true);
+        b->setIconSize(QSize(24, 24));
+        const Entry copy = en;
+        QObject::connect(b, &QToolButton::clicked, mw, [copy, tool, erase]() {
+            tool->trigger();
+            if (erase && QLatin1String(copy.id) == QLatin1String("KritaShape/KisToolBrush")
+                    && erase->isChecked() != copy.eraser) {
+                erase->trigger();
+            }
+        });
+        l->addWidget(b);
+        buttons << qMakePair(b, en);
+    }
+    KoToolManager *toolManager = mw->viewManager()->toolManager();
+    auto sync = [buttons, erase, toolManager]() {
+        const QString active = toolManager->activeToolId();
+        const bool erasing = erase && erase->isChecked();
+        for (const auto &pair : buttons) {
+            const QLatin1String id(pair.second.id);
+            const bool isBrush = id == QLatin1String("KritaShape/KisToolBrush");
+            pair.first->setChecked(active == id && (!isBrush || pair.second.eraser == erasing));
+        }
+    };
+    QObject::connect(toolManager, &KoToolManager::changedTool, bar, [sync](KoCanvasController *) { sync(); });
+    if (erase) QObject::connect(erase, &QAction::toggled, bar, [sync](bool) { sync(); });
+    QTimer::singleShot(0, bar, sync);
+    bar->adjustSize();
+    bar->hide();
+
+    static const char *SVG_UNFOCUS = "<path d='M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5'/>";
+    QToolButton *exit = new QToolButton(mw);
+    exit->setObjectName(QStringLiteral("nanquimFocusExit"));
+    exit->setToolTip(i18n("Sair do modo foco"));
+    exit->setIcon(designIcon(SVG_UNFOCUS, 24));
+    exit->setIconSize(QSize(24, 24));
+    exit->setFixedSize(48, 48);
+    exit->setFocusPolicy(Qt::NoFocus);
+    exit->setStyleSheet(QStringLiteral(
+        "QToolButton { background: rgba(34,38,44,0.92); border: 1px solid #33373f; border-radius: 24px; }"
+        "QToolButton:pressed { background: #2a2e35; }"));
+    QObject::connect(exit, &QToolButton::clicked, mw, [mw]() { setFocusMode(mw, false); });
+    exit->hide();
+}
+
+void applyFocusVisibility(KisMainWindow *mw)
+{
+    const bool on = s_focusMode;
+    if (QToolBar *top = mw->findChild<QToolBar*>(TOP_ID)) top->setVisible(!on);
+    if (QToolBar *nav = mw->findChild<QToolBar*>(NAV_ID)) nav->setVisible(!on && !s_navCollapsed);
+    if (QWidget *tab = mw->findChild<QWidget*>(QStringLiteral("nanquimExpandTab"))) tab->setVisible(!on && s_navCollapsed);
+    setThumbDockVisible(mw, !on);
+    flushLayouts();
+    if (QWidget *bar = mw->findChild<QWidget*>(QStringLiteral("nanquimFocusBar"))) bar->setVisible(on);
+    if (QWidget *exit = mw->findChild<QWidget*>(QStringLiteral("nanquimFocusExit"))) exit->setVisible(on);
+    placeFocusWidgets(mw);
+    if (!on && s_navCollapsed) {
+        if (QToolButton *tab = mw->findChild<QToolButton*>(QStringLiteral("nanquimExpandTab"))) positionExpandTab(mw, tab);
+    }
+}
+
+void setFocusMode(KisMainWindow *mw, bool on)
+{
+    if (s_focusMode == on) return;
+    s_focusMode = on;
+    if (on) {
+        if (QDockWidget *dw = hostedDock(mw)) closePanel(mw, dw, false);
+        setBrushPanelVisible(mw, false);
+        if (QFrame *flyout = mw->findChild<QFrame*>(FLYOUT_ID)) flyout->hide();
+        if (QWidget *wheel = mw->findChild<QWidget*>(QStringLiteral("nanquimWheel"))) wheel->hide();
+    }
+    applyFocusVisibility(mw);
+    if (on) showToast(mw, i18n("Modo foco · dois dedos desfazem, três refazem"));
+}
